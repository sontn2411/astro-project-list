---
import noImage43 from "../assets/no-image-4-3.png";
import noImage169 from "../assets/no-image-16-9.png";

export interface Props {
  src?: string | null | undefined;
  alt?: string;
  ratio?: "4:3" | "16:9";
  class?: string;
  loading?: "lazy" | "eager";
  [key: string]: any;
}

const {
  src,
  alt = "Image",
  ratio = "16:9",
  class: className,
  loading = "lazy",
  ...rest
} = Astro.props;

const fallbackSrc = ratio === "4:3" ? noImage43.src : noImage169.src;
const initialSrc = src ? src : fallbackSrc;
---

<img
  src={initialSrc}
  alt={alt}
  class={className}
  loading={loading}
  onerror={`this.onerror=null;this.src='${fallbackSrc}';`}
  {...rest}
/>
