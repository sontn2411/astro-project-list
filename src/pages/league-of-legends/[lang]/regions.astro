---
import Layout from "../_components/Layout.astro";
import RegionHero from "../_components/RegionHero.astro";
import RegionList from "../_components/RegionList.astro";
import { getI18n, supportedLocales } from "../_data/i18n";
import { getRegions } from "../_data/regions";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { lang: locale.code },
  }));
}

const { lang } = Astro.params;
const { t, lang: currentLang } = getI18n(lang);
const regions = await getRegions();
---

<Layout
  title={`${t.nav.regions} - ${t.regionsPage.title} | ${t.meta.title}`}
  desc={t.regionsPage.desc}
  lang={currentLang}
>
  <RegionHero lang={currentLang} regions={regions} />
</Layout>
