---
import { getI18n } from "../_data/i18n";
import type { Region } from "../_data/regions";
import RegionCard from "./RegionCard.astro";

interface Props {
  regions: Region[];
  lang?: string;
}

const { regions, lang = "vi_VN" } = Astro.props;
const { t, lang: currentLang } = getI18n(lang);
---

<div class="z-20 mt-10 sm:mt-14 w-full" id="region-list-container">
  <!-- 1. Thanh Tìm Kiếm Vùng Đất Tức Thì (Live Filter Bar) -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
    <div class="relative w-full sm:max-w-md">
      <input
        id="region-search-input"
        type="text"
        placeholder={t.regionsPage.searchPlaceholder}
        class="w-full pl-11 pr-10 py-3 bg-[#0d151b]/90 border border-[#2d3435] hover:border-[#8e6b32] focus:border-[#c99a45] focus:bg-[#121c21] rounded-md text-ivory placeholder:text-[#6f6a61] text-xs font-medium tracking-wide transition-all outline-none shadow-inner"
      />
      <!-- Search Icon -->
      <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#a89f90] pointer-events-none">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <!-- Clear button -->
      <button
        id="region-search-clear"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-[#a89f90] hover:text-[#e2b866] hidden p-1 cursor-pointer transition-colors"
        aria-label="Clear Search"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="flex items-center gap-3 text-xs text-[#a89f90] font-medium tracking-wider w-full sm:w-auto justify-between sm:justify-end">
      <span id="region-counter" class="text-[#c99a45] font-semibold">
        {currentLang === "vi_VN" ? `Hiển thị ${regions.length} / ${regions.length} vùng đất` : `Showing ${regions.length} / ${regions.length} regions`}
      </span>
    </div>
  </div>

  <!-- 2. Grid danh sách các vùng đất -->
  <div
    id="regions-grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 w-full"
  >
    {regions.map((region) => (
      <RegionCard region={region} lang={lang} />
    ))}
  </div>

  <!-- 3. Empty State khi không tìm thấy kết quả -->
  <div
    id="region-empty-state"
    class="hidden py-24 flex-col items-center justify-center text-center max-w-md mx-auto"
  >
    <div class="w-16 h-16 rounded-full bg-[#0d151b] border border-[#c99a45]/40 flex items-center justify-center text-[#c99a45] mb-4 shadow-[0_0_20px_rgba(201,154,69,0.2)]">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </div>

    <h3 class="text-xl font-display font-bold text-white uppercase tracking-wider mb-2">
      {t.regionsPage.noResultsTitle}
    </h3>
    <p class="text-xs text-[#a89f90] leading-relaxed mb-6">
      {t.regionsPage.noResultsDesc}
    </p>

    <button
      id="region-empty-reset"
      type="button"
      class="px-5 py-2.5 rounded bg-[#c99a45]/20 hover:bg-[#c99a45] border border-[#c99a45] text-[#e2b866] hover:text-black text-xs font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer shadow-md"
    >
      {t.regionsPage.clearFilter}
    </button>
  </div>
</div>

<script is:inline define:vars={{ currentLang, totalCount: regions.length }}>
  (function () {
    const searchInput = document.getElementById("region-search-input");
    const clearBtn = document.getElementById("region-search-clear");
    const counter = document.getElementById("region-counter");
    const emptyState = document.getElementById("region-empty-state");
    const emptyResetBtn = document.getElementById("region-empty-reset");
    const grid = document.getElementById("regions-grid");
    const cards = document.querySelectorAll(".region-card");

    function filterRegions() {
      const query = (searchInput?.value || "").trim().toLowerCase();

      if (clearBtn) {
        if (query) {
          clearBtn.classList.remove("hidden");
        } else {
          clearBtn.classList.add("hidden");
        }
      }

      let visibleCount = 0;

      cards.forEach((card) => {
        const slug = card.getAttribute("data-slug") || "";
        const name = card.getAttribute("data-name") || "";
        const enName = card.getAttribute("data-en-name") || "";
        const viName = card.getAttribute("data-vi-name") || "";

        const isMatch =
          !query ||
          slug.includes(query) ||
          name.includes(query) ||
          enName.includes(query) ||
          viName.includes(query);

        if (isMatch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      // Cập nhật bộ đếm
      if (counter) {
        if (currentLang === "vi_VN") {
          counter.textContent = `Hiển thị ${visibleCount} / ${totalCount} vùng đất`;
        } else {
          counter.textContent = `Showing ${visibleCount} / ${totalCount} regions`;
        }
      }

      // Toggle empty state
      if (emptyState && grid) {
        if (visibleCount === 0) {
          emptyState.classList.remove("hidden");
          emptyState.classList.add("flex");
          grid.classList.add("hidden");
        } else {
          emptyState.classList.add("hidden");
          emptyState.classList.remove("flex");
          grid.classList.remove("hidden");
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", filterRegions);
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
          filterRegions();
        }
      });
    }

    if (emptyResetBtn) {
      emptyResetBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          filterRegions();
        }
      });
    }
  })();
</script>
