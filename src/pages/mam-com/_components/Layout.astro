---
import Layout from '../../../layouts/Layout.astro';
import Header from './Header.astro';

interface Props {
  title: string;
  desc?: string;
}

const { title, desc } = Astro.props;
---

<Layout title={title} description={desc}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&family=Charm:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Dancing+Script:wght@400..700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700;1,800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </Fragment>

  <main transition:animate="fade" class="font-be-vietnam min-h-screen">
    <!-- <Header /> -->
    <slot />
  </main>
</Layout>
