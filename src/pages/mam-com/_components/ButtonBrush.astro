---
import bgButton from '../_assets/bg-button.png';

interface Props {
  text?: string;
  href?: string;
  class?: string;
  fontSize?: number | string;
  fontWeight?: number | string;
  letterSpacing?: number | string;
  [key: string]: any;
}

const {
  text = "Khám phá mâm cơm  →",
  href = "#kham-pha",
  class: className = "w-60 sm:w-72 md:w-80 lg:w-[330px]",
  fontSize = 82,
  fontWeight = 800,
  letterSpacing = 1.5,
  ...props
} = Astro.props;

// Tạo mask ID ngẫu nhiên để tránh trùng ID khi sử dụng nhiều nút trên cùng 1 trang
const maskId = `btn-text-mask-${Math.random().toString(36).substring(2, 9)}`;
---

<a
  href={href}
  class:list={[
    "group relative inline-block aspect-[921/209] select-none drop-shadow-[0_4px_10px_rgba(0,0,0,0.32)] hover:scale-105 active:scale-95 transition-all duration-300",
    className,
  ]}
  {...props}
>
  <svg
    class="w-full h-full overflow-visible"
    viewBox="0 0 921 209"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <mask id={maskId}>
        <!-- Nền trắng giữ lại toàn bộ vệt sơn đỏ của nút -->
        <rect width="921" height="209" fill="white" />
        <!-- Chữ màu đen đục rỗng để lộ hoàn toàn nền giấy phía sau -->
        <text
          x="460.5"
          y="102"
          text-anchor="middle"
          dominant-baseline="central"
          fill="black"
          font-family="'Cormorant Garamond', Georgia, serif"
          font-size={fontSize}
          font-weight={fontWeight}
          letter-spacing={letterSpacing}
        >
          {text}
        </text>
      </mask>
    </defs>
    <image
      href={bgButton.src}
      width="921"
      height="209"
      preserveAspectRatio="none"
      mask={`url(#${maskId})`}
    />
  </svg>
</a>
