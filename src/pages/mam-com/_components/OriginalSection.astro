---
import { Image } from "astro:assets";
import bgOriginal from "../_assets/bg-original.png";
import trongDongImg from "../_assets/trong-dong.png";
import mamTreImg from "../_assets/mam-com.png";
import chenComImg from "../_assets/chen-com.png";

const timelineItems = [
  {
    image: trongDongImg,
    alt: "Trống đồng Đông Sơn",
    title: "Trống đồng Đông Sơn",
    desc: "Biểu tượng của mặt trời, của sự sống và cộng đồng.",
  },
  {
    image: mamTreImg,
    alt: "Mâm tre truyền thống",
    title: "Mâm tre",
    desc: "Vật dụng quen thuộc trong mỗi gia đình.",
  },
  {
    image: chenComImg,
    alt: "Mâm cơm gia đình",
    title: "Mâm cơm",
    desc: "Hình ảnh của sự đoàn viên, ấm no, hạnh phúc.",
  },
];
---

<section id="original-section" class="relative isolate w-full overflow-hidden bg-[#ede1cb] min-h-[460px] md:min-h-[520px] lg:min-h-[560px] flex items-center py-12 sm:py-16 md:py-20 lg:py-24">
  <!-- Ảnh nền phong cảnh cổ thủy mặc -->
  <Image 
    src={bgOriginal} 
    alt="Bối cảnh nguồn gốc mâm cơm" 
    class="orig-bg absolute inset-0 w-full h-full object-cover pointer-events-none select-none transform-gpu" 
    loading="lazy"
  />

  <!-- Khung nội dung chính -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-12 items-center">
      
      <!-- Cột bên trái: Tiêu đề & Nội dung mô tả -->
      <div class="lg:col-span-4 xl:col-span-4 space-y-2.5 sm:space-y-3.5 max-w-lg">
        <p class="orig-subtitle font-serif-vintage! text-xs sm:text-sm md:text-base uppercase tracking-[0.2em] text-[#331a0b] font-bold flex items-center gap-1.5">
          Nguồn gốc <span class="opacity-90 font-bold">~</span>
        </p>

        <h2 class="orig-title font-serif-vintage! text-3xl sm:text-4xl md:text-5xl lg:text-[42px] xl:text-5xl text-[#120702] font-semibold md:font-bold leading-[1.18] tracking-tight">
          Ba nghìn năm<br />
          trên một vòng tròn
        </h2>

        <p class="orig-desc font-serif-vintage! text-sm sm:text-base md:text-lg lg:text-xl text-[#200f06] font-medium md:font-semibold leading-relaxed pt-1 sm:pt-2">
          Từ mặt trống đồng Đông Sơn, hình tròn đã trở thành biểu tượng của sự gắn kết, của cộng đồng và gia đình. Qua thời gian, hình ảnh ấy vẫn còn trong mâm cơm Việt.
        </p>
      </div>

      <!-- Cột bên phải: Dòng chảy tiến hóa 3 biểu tượng (Trống đồng -> Mâm tre -> Mâm cơm) chia đều không gian -->
      <div class="lg:col-span-8 xl:col-span-8 w-full">
        <div class="w-full flex items-start justify-between gap-2 sm:gap-4 md:gap-6 xl:gap-8">
          {timelineItems.map((item, index) => (
            <>
              <!-- Thẻ từng biểu tượng -->
              <div class="orig-card flex-1 flex flex-col items-center text-center group min-w-0 transform-gpu">
                <!-- Khung chứa ảnh tròn với hiệu ứng đổ bóng tự nhiên -->
                <div class="relative w-24 sm:w-32 md:w-40 lg:w-40 xl:w-48 aspect-square flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
                  <Image 
                    src={item.image} 
                    alt={item.alt} 
                    class="w-full h-full object-contain drop-shadow-[0_8px_18px_rgba(0,0,0,0.24)] select-none" 
                    loading="lazy"
                  />
                </div>

                <!-- Tiêu đề biểu tượng -->
                <h3 class="font-serif-vintage! font-bold text-sm sm:text-base md:text-lg lg:text-xl text-[#120702] mt-3 sm:mt-4 leading-snug">
                  {item.title}
                </h3>

                <!-- Mô tả ngắn dưới biểu tượng -->
                <p class="font-serif-vintage! text-[11px] sm:text-xs md:text-sm lg:text-base text-[#200f06] font-medium md:font-semibold leading-relaxed mt-1 sm:mt-1.5 max-w-[190px] sm:max-w-[220px] xl:max-w-[240px]">
                  {item.desc}
                </p>
              </div>

              <!-- Mũi tên liên kết giữa các mốc (không hiển thị sau item cuối) -->
              {index < timelineItems.length - 1 && (
                <div class="orig-arrow shrink-0 flex items-center justify-center text-[#331a0b] opacity-80 mt-10 sm:mt-14 md:mt-16 lg:mt-16 xl:mt-20 transform-gpu origin-left">
                  <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    class="w-4 h-4 sm:w-6 sm:h-6 md:w-7 md:h-7 xl:w-8 xl:h-8" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </div>
              )}
            </>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  let origCtx: gsap.Context | null = null;
  let origObserver: IntersectionObserver | null = null;

  function initOriginalSectionAnimations() {
    if (origCtx) {
      origCtx.revert();
    }
    if (origObserver) {
      origObserver.disconnect();
    }

    const origSection = document.querySelector("#original-section");
    if (!origSection) return;

    origCtx = gsap.context(() => {
      // Ẩn ban đầu để chuẩn bị xuất hiện khi cuộn tới
      gsap.set(".orig-subtitle, .orig-title, .orig-desc, .orig-card, .orig-arrow", {
        opacity: 0
      });

      const playAnimation = () => {
        const tl = gsap.timeline({
          defaults: { ease: "power2.out" }
        });

        // 1. Phụ đề cột trái
        tl.fromTo(
          ".orig-subtitle",
          { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.45 },
          0
        );

        // 2. Tiêu đề lớn
        tl.fromTo(
          ".orig-title",
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.55 },
          0.1
        );

        // 3. Đoạn mô tả
        tl.fromTo(
          ".orig-desc",
          { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.5 },
          0.2
        );

        // 4. Tuần tự xuất hiện 3 thẻ biểu tượng và 2 mũi tên nối tiếp
        const cards = gsap.utils.toArray(".orig-card");
        const arrows = gsap.utils.toArray(".orig-arrow");

        cards.forEach((card, i) => {
          const startTime = 0.3 + i * 0.22;

          tl.fromTo(
            card,
            { opacity: 0, scale: 0.88, y: 18 },
            { opacity: 1, scale: 1, y: 0, duration: 0.6, ease: "back.out(1.6)" },
            startTime
          );

          if (arrows[i]) {
            tl.fromTo(
              arrows[i],
              { opacity: 0, scaleX: 0, x: -8 },
              { opacity: 0.8, scaleX: 1, x: 0, duration: 0.4 },
              startTime + 0.15
            );
          }
        });
      };

      // Kích hoạt timeline khi người dùng cuộn đến vị trí section
      origObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playAnimation();
              origObserver?.disconnect();
            }
          });
        },
        { threshold: 0.15 }
      );

      origObserver.observe(origSection);
    }, origSection);
  }

  // Khởi tạo an toàn với Astro View Transitions
  document.addEventListener("astro:page-load", initOriginalSectionAnimations);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initOriginalSectionAnimations();
  } else {
    document.addEventListener("DOMContentLoaded", initOriginalSectionAnimations);
  }
</script>