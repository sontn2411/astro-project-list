---
import { Image } from "astro:assets";
import bgProduct from "../_assets/bg-products.jpg";
import thitKhoTrungImg from "../_assets/thit-kho-trung.png";
---

<section 
  id="products-section" 
  style={`background-image: url('${bgProduct.src}');`}
  class="relative isolate w-full overflow-hidden bg-[#160e08] bg-cover bg-center py-10  "
>
  <!-- Lớp phủ bóng mờ cổ điển tạo chiều sâu -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/35 to-black/65 pointer-events-none -z-1"></div>
  <div class="absolute inset-0 bg-black/25 pointer-events-none -z-1"></div>

 <div class="h-125 flex justify-between">
 
    <Image src={thitKhoTrungImg} alt="Thịt kho trứng" class=" transform-gpu object-center"  />

    

 </div>

</section>
