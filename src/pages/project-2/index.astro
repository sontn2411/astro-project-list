---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const navLinks = [
  { href: '/project-2/', label: 'Tổng quan' },
  { href: '/project-2/gallery/', label: 'Gallery' },
  { href: '/project-2/docs/', label: 'Tài liệu' },
];
---

<ProjectLayout
  projectName="Project 2"
  projectSlug="project-2"
  title="Tổng quan"
  description="Trang tổng quan của Project 2"
  navLinks={navLinks}
>
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-white mb-3">Project 2</h1>
      <p class="text-gray-400 text-lg">Mô tả tổng quan về project 2 của bạn.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {[
        { label: 'Trang con', value: '3', desc: 'Số trang trong project' },
        { label: 'Phiên bản', value: '2.0', desc: 'Version hiện tại' },
        { label: 'Trạng thái', value: 'Active', desc: 'Đang phát triển' },
      ].map((stat) => (
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <p class="text-3xl font-bold text-emerald-400">{stat.value}</p>
          <p class="font-medium text-white mt-1">{stat.label}</p>
          <p class="text-sm text-gray-500 mt-0.5">{stat.desc}</p>
        </div>
      ))}
    </div>

    <div class="rounded-xl border border-white/10 bg-white/5 p-6">
      <h2 class="text-xl font-semibold text-white mb-4">Các trang con</h2>
      <ul class="space-y-2">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors py-1">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
              {link.label} — <code class="text-xs text-gray-500">{link.href}</code>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</ProjectLayout>
