---
import { Icon } from "astro-icon/components";
import SafeImage from "../../../../components/SafeImage.astro";

const resorts = [
  {
    title: "Vinpearl Luxury Nha Trang",
    location: "Đảo Hòn Tre, Nha Trang",
    rating: 5,
    tag: "Đẳng cấp quốc tế",
    image:
      "https://images.unsplash.com/photo-1542314831-c6a4d27ece91?w=800&q=80",
    class: "md:col-span-2 md:row-span-1",
  },
  {
    title: "Amiana Resort",
    location: "Vịnh Nha Trang",
    rating: 5,
    tag: "View biển đẹp nhất",
    image:
      "https://images.unsplash.com/photo-1582719508461-905c673771fd?w=800&q=80",
    class: "md:col-span-1 md:row-span-1",
  },
  {
    title: "InterContinental Nha Trang",
    location: "Đường Trần Phú, trung tâm",
    rating: 5,
    tag: "Trung tâm sầm uất",
    image:
      "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80",
    class: "md:col-span-1 md:row-span-1",
  },
  {
    title: "Six Senses Ninh Van Bay",
    location: "Vịnh Ninh Vân",
    rating: 5,
    tag: "Nghỉ dưỡng sinh thái",
    image:
      "https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?w=800&q=80",
    class: "md:col-span-2 md:row-span-1",
  },
];
---

<section class="max-w-[1400px] mx-auto px-4 md:px-8 py-16 mt-20">
  <div class="mb-10 flex flex-col md:flex-row items-end justify-between gap-4">
    <div>
      <p
        class="font-allura text-3xl md:text-4xl text-[#E57B3E] mb-2 leading-none"
      >
        Lựa chọn hàng đầu
      </p>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 leading-tight"
      >
        Khu nghỉ dưỡng nổi bật
      </h2>
    </div>
  </div>

  <div
    class="grid grid-cols-1 md:grid-cols-3 auto-rows-[320px] lg:auto-rows-[360px] gap-4 lg:gap-6"
  >
    {
      resorts.map((item) => (
        <div
          class={`relative rounded-[32px] overflow-hidden group cursor-pointer ${item.class}`}
        >
          <SafeImage
            src={item.image}
            alt={item.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
          <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-end">
            <div class="mb-auto">
              <span class="inline-block px-4 py-1.5 bg-white text-gray-900 text-[10px] font-extrabold uppercase tracking-[0.15em] rounded-full shadow-lg">
                {item.tag}
              </span>
            </div>
            <div>
              <div class="flex items-center gap-1 text-[#F59E0B] mb-2.5">
                {Array.from({ length: item.rating }).map(() => (
                  <Icon name="lucide:star" class="w-4 h-4 fill-current" />
                ))}
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white mb-2 leading-tight">
                {item.title}
              </h3>
              <div class="flex items-center gap-1.5 text-white/80 text-sm font-medium">
                <Icon name="lucide:map-pin" class="w-4 h-4 shrink-0" />
                {item.location}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
