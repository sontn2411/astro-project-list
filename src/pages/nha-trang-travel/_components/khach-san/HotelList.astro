const categories = ["Tất cả", "Khách sạn 5 sao", "Resort", "Căn hộ", "Boutique", "Homestay"];
---

<section class="max-w-[1400px] mx-auto px-4 md:px-8 pb-20">
  
  <!-- Element ẩn để theo dõi sự kiện scroll tới vị trí sticky -->
  <div id="filter-sentinel" class="w-full h-[1px]"></div>
  
  <!-- Bộ lọc nằm ngang (Horizontal Sticky Filter) -->
  <div id="hotel-filter" class="sticky top-[70px] z-30 transition-all duration-300 border-y border-transparent py-4 mb-8 px-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <!-- Danh mục -->
    <div class="flex items-center gap-2 overflow-x-auto w-full no-scrollbar pb-2 md:pb-0">
      {categories.map((cat, index) => (
        <button class={`shrink-0 px-5 py-2.5 rounded-full text-sm font-bold transition-colors ${index === 0 ? 'bg-travel-primary text-white' : 'bg-[#FCFAF5] text-gray-600 hover:bg-gray-100'}`}>
          {cat}
        </button>
      ))}
    </div>

    <!-- Sắp xếp & Nút bộ lọc nâng cao -->
    <div class="flex items-center gap-3 shrink-0">
      <button class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-gray-200 text-sm font-bold text-gray-700 hover:bg-gray-50 transition-colors">
        <Icon name="lucide:arrow-down-up" class="w-4 h-4" />
        Sắp xếp
      </button>
      <button class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-gray-200 text-sm font-bold text-gray-700 hover:bg-gray-50 transition-colors">
        <Icon name="lucide:sliders-horizontal" class="w-4 h-4" />
        Bộ lọc
      </button>
    </div>
  </div>

  <!-- Hotel List Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 lg:gap-6">
    {hotels.map((hotel) => (
      <div class="bg-white rounded-[24px] border border-gray-100 overflow-hidden hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-all group flex flex-col h-full">
        
        <!-- Image Area -->
        <div class="relative h-56 overflow-hidden shrink-0">
          <SafeImage 
            src={hotel.image} 
            alt={hotel.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            ratio="4:3"
          />
          
          {hotel.badge && (
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-lg text-[10px] font-bold text-gray-900 uppercase tracking-wide shadow-sm">
              {hotel.badge}
            </div>
          )}

          <button class="absolute top-4 right-4 w-9 h-9 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-400 hover:text-red-500 hover:scale-110 transition-all shadow-sm">
            <Icon name="lucide:heart" class="w-4.5 h-4.5" />
          </button>
        </div>

        <!-- Content Area -->
        <div class="p-6 flex flex-col flex-1">
          <!-- Rating -->
          <div class="flex items-center gap-1 text-[#F59E0B] mb-2">
            {Array.from({length: hotel.rating}).map(() => (
              <Icon name="lucide:star" class="w-3 h-3 fill-current" />
            ))}
            <span class="text-xs text-gray-400 ml-1">({hotel.reviews})</span>
          </div>

          <h3 class="text-lg font-bold text-gray-900 leading-tight mb-2">
            {hotel.title}
          </h3>
          
          <div class="flex items-center gap-1.5 text-gray-500 text-xs mb-3">
            <Icon name="lucide:map-pin" class="w-3.5 h-3.5 shrink-0" />
            <span class="truncate font-medium">{hotel.location}</span>
          </div>
          
          <p class="text-sm text-gray-600 line-clamp-2 mb-4 leading-relaxed">
            {hotel.description}
          </p>

          <!-- Amenities -->
          <div class="flex flex-wrap gap-2 mb-6">
            {hotel.amenities.map(amenity => (
              <span class="px-2.5 py-1 bg-[#FCFAF5] rounded-md text-[11px] font-medium text-gray-600 border border-[#F2EFE8]">
                {amenity}
              </span>
            ))}
          </div>

          <!-- Footer info -->
          <div class="mt-auto flex items-end justify-between pt-4 border-t border-gray-100">
            <div>
              <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Giá mỗi đêm từ</div>
              <div class="flex flex-col">
                {hotel.originalPrice && (
                  <span class="text-xs text-gray-400 line-through mb-0.5">{hotel.originalPrice}</span>
                )}
                <span class="text-xl font-extrabold" style="color: #E57B3E;">{hotel.price}</span>
              </div>
            </div>
            <button class="bg-travel-primary text-white text-sm font-bold py-2.5 px-5 rounded-xl hover:bg-travel-primary/90 transition-colors">
              Xem phòng
            </button>
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Load More -->
  <div class="mt-12 flex justify-center">
    <button class="px-8 py-3.5 rounded-full border-2 border-gray-200 text-gray-700 font-bold hover:border-travel-primary hover:text-travel-primary transition-colors">
      Hiển thị thêm khách sạn
    </button>
  </div>

</section>

<script>
  // Chạy khi trang web đã load (hỗ trợ cả View Transitions của Astro nếu có)
  document.addEventListener('DOMContentLoaded', initStickyFilter);
  document.addEventListener('astro:page-load', initStickyFilter);

  function initStickyFilter() {
    const sentinel = document.getElementById('filter-sentinel');
    const filter = document.getElementById('hotel-filter');

    if (!sentinel || !filter) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // Khi sentinel bị cuộn khuất khỏi viewport (vượt mốc 80px từ top)
        if (!entry.isIntersecting && entry.boundingClientRect.top <= 80) {
          filter.classList.add('bg-white/90', 'backdrop-blur-md', 'border-gray-100', 'shadow-sm');
          filter.classList.remove('border-transparent');
        } else {
          // Khi sentinel xuất hiện lại trên màn hình
          filter.classList.remove('bg-white/90', 'backdrop-blur-md', 'border-gray-100', 'shadow-sm');
          filter.classList.add('border-transparent');
        }
      });
    }, {
      rootMargin: '-80px 0px 0px 0px',
      threshold: 0
    });

    observer.observe(sentinel);
  }
</script>
