---
import { Icon } from "astro-icon/components";
import SafeImage from "../../../../components/SafeImage.astro";
---

<section class="max-w-[1400px] mx-auto px-4 md:px-8 pb-20">
  <div
    class="bg-travel-primary rounded-[32px] relative overflow-hidden flex items-center min-h-[320px]"
  >
    <!-- Placeholder: Ảnh trái (User sẽ thay sau) -->
    <div
      class="absolute top-0 left-0 bottom-0 w-full md:w-5/12 lg:w-4/12 opacity-20 md:opacity-80"
    >
      <SafeImage
        src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600&q=80"
        alt="Scuba diving"
        class="w-full h-full object-cover"
        style="mask-image: linear-gradient(to right, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 50%, transparent 100%);"
      />
    </div>

    <!-- Placeholder: Họa tiết phải (User sẽ thay sau) -->
    <div
      class="absolute top-0 right-0 bottom-0 w-1/3 hidden lg:block opacity-20 pointer-events-none"
    >
      <!-- Nơi chứa ảnh họa tiết Tháp Bà Ponagar -->
    </div>

    <!-- Main Content -->
    <div
      class="relative z-10 w-full md:w-7/12 lg:w-8/12 py-14 px-6 md:px-8 lg:px-12 flex flex-col items-start text-center ml-auto"
    >
      <p
        class="font-allura text-3xl md:text-4xl text-[#E57B3E] mb-2 leading-none"
      >
        Ưu đãi độc quyền
      </p>

      <h2
        class="text-2xl md:text-3xl lg:text-[32px] font-bold text-white mb-3 leading-tight"
      >
        Đăng ký nhận ưu đãi và trải nghiệm mới nhất
      </h2>

      <p class="text-white/80 text-sm md:text-base mb-8 max-w-xl font-medium">
        Nhận ngay thông tin khuyến mãi, trải nghiệm đặc sắc tại Nha Trang
      </p>

      <!-- Input Form -->
      <div class="w-full max-w-[500px] relative mt-2">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center bg-transparent sm:bg-white rounded-none sm:rounded-full p-0 sm:p-1.5 shadow-none sm:shadow-xl gap-3 sm:gap-0">
          
          <div class="flex items-center bg-white rounded-full p-3 sm:p-0 flex-1 shadow-xl sm:shadow-none">
            <div class="pl-4 pr-2 text-gray-400 shrink-0">
              <Icon name="lucide:mail" class="w-5 h-5" />
            </div>
            <input
              type="email"
              placeholder="Nhập email của bạn"
              class="flex-1 bg-transparent border-none outline-none px-2 sm:px-2 text-sm text-gray-900 placeholder-gray-400 w-full"
            />
          </div>

          <button
            class="w-full sm:w-auto bg-[#E57B3E] hover:bg-[#d66b2d] transition-colors text-white text-sm font-bold py-3.5 sm:py-3 px-6 md:px-8 rounded-full whitespace-nowrap shrink-0 shadow-xl sm:shadow-none"
          >
            Đăng ký ngay
          </button>

        </div>
      </div>
    </div>
  </div>
</section>
