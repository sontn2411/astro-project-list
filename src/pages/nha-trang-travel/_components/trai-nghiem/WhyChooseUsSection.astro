---
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "lucide:shield-check",
    title: "Trải nghiệm chất lượng",
    description: "Đối tác uy tín, dịch vụ được chọn lọc kỹ càng",
  },
  {
    icon: "lucide:headphones",
    title: "Hỗ trợ 24/7",
    description: "Đồng hành cùng bạn trong suốt hành trình",
  },
  {
    icon: "lucide:tags",
    title: "Giá tốt nhất",
    description: "Cam kết giá cạnh tranh, không phí ẩn",
  },
  {
    icon: "lucide:calendar-check",
    title: "Hủy linh hoạt",
    description: "Hủy dễ dàng trước 24h với nhiều trải nghiệm",
  },
];
---

<section class="max-w-[1400px] mx-auto px-4 md:px-8 pb-16">
  <div class="bg-[#f5f3ec] rounded-3xl p-8 md:p-12">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
        Vì sao nên chọn trải nghiệm cùng chúng tôi?
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-10 sm:gap-y-12 gap-x-8 sm:divide-x divide-gray-200/60">
      {
        features.map((item, index) => (
          <div class={`flex flex-col items-center text-center px-4 ${index === 2 ? 'sm:border-l-0 lg:border-l' : ''}`}>
            <Icon
              name={item.icon}
              class="w-8 h-8 text-travel-primary mb-4"
            />
            <h3 class="text-base font-bold text-gray-900 mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
    
  </div>
</section>
