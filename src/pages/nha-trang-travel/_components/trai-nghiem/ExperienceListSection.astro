---
import { Icon } from "astro-icon/components";
import SafeImage from "../../../../components/SafeImage.astro";

const experiences = [
  {
    id: 1,
    badge: "Phổ biến",
    title: "Tour 4 đảo Nha Trang",
    location: "Nha Trang, Khánh Hòa",
    description: "Khám phá 4 hòn đảo tuyệt đẹp: Hòn Mun, Hòn Một, Hòn Miễu, Bãi Tranh",
    duration: "1 ngày",
    rating: 4.8,
    reviews: 1256,
    price: "1.200.000đ",
    image: "https://images.unsplash.com/photo-1583417319070-4a69db38a482?w=600&q=80"
  },
  {
    id: 2,
    badge: "Yêu thích",
    title: "Lặn biển ngắm san hô",
    location: "Hòn Mun, Nha Trang",
    description: "Trải nghiệm thế giới đại dương kỳ thú với hệ sinh thái san hô rực rỡ",
    duration: "3 - 4 giờ",
    rating: 4.9,
    reviews: 856,
    price: "700.000đ",
    image: "https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600&q=80"
  },
  {
    id: 3,
    badge: "Mới",
    title: "Cáp treo Vinpearl & VinWonders",
    location: "Vinpearl, Nha Trang",
    description: "Trải nghiệm cáp treo vượt biển dài nhất thế giới và vui chơi tại VinWonders",
    duration: "1 ngày",
    rating: 4.7,
    reviews: 642,
    price: "880.000đ",
    image: "https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=600&q=80"
  },
  {
    id: 4,
    badge: null,
    title: "Ẩm thực Nha Trang",
    location: "Nha Trang, Khánh Hòa",
    description: "Thưởng thức đặc sản trứ danh của thành phố biển",
    duration: "3 - 4 giờ",
    rating: 4.6,
    reviews: 532,
    price: "450.000đ",
    image: "https://images.unsplash.com/photo-1580476262798-bddd9f4b7369?w=600&q=80"
  },
  {
    id: 5,
    badge: null,
    title: "Tháp Bà Ponagar",
    location: "Nha Trang, Khánh Hòa",
    description: "Khám phá công trình kiến trúc Chăm Pa cổ kính hơn 1.200 năm tuổi",
    duration: "2 - 3 giờ",
    rating: 4.7,
    reviews: 912,
    price: "120.000đ",
    image: "https://images.unsplash.com/photo-1579532650085-f5fbdbfbf62a?w=600&q=80"
  },
  {
    id: 6,
    badge: null,
    title: "Du thuyền ngắm hoàng hôn",
    location: "Vịnh Nha Trang",
    description: "Thư giãn trên du thuyền sang trọng, thưởng thức hoàng hôn tuyệt đẹp",
    duration: "2 - 4 giờ",
    rating: 4.8,
    reviews: 745,
    price: "950.000đ",
    image: "https://images.unsplash.com/photo-1589574895240-385d3f82029b?w=600&q=80"
  },
  {
    id: 7,
    badge: null,
    title: "Suối Ba Hồ Trekking",
    location: "Ninh Hòa, Khánh Hòa",
    description: "Trekking khám phá 3 hồ nước tự nhiên thơ mộng giữa núi rừng",
    duration: "1 ngày",
    rating: 4.6,
    reviews: 423,
    price: "650.000đ",
    image: "https://images.unsplash.com/photo-1616781489094-1a35cc24a30e?w=600&q=80"
  },
  {
    id: 8,
    badge: null,
    title: "Moto nước tại Bãi Tranh",
    location: "Nha Trang, Khánh Hòa",
    description: "Cảm giác mạnh với trò chơi moto nước trên biển xanh Nha Trang",
    duration: "15 - 30 phút",
    rating: 4.9,
    reviews: 312,
    price: "300.000đ",
    image: "https://images.unsplash.com/photo-1602057962137-b6a8360d5b36?w=600&q=80"
  }
];

const categories = [
  { label: "Tất cả trải nghiệm", icon: "lucide:layout-grid", active: true },
  { label: "Tham quan - Khám phá", icon: "lucide:map", active: false },
  { label: "Thể thao - Mạo hiểm", icon: "lucide:bike", active: false },
  { label: "Ẩm thực", icon: "lucide:utensils", active: false },
  { label: "Văn hóa - Lịch sử", icon: "lucide:landmark", active: false },
  { label: "Giải trí - Thư giãn", icon: "lucide:smile", active: false }
];
---

<section class="max-w-[1400px] mx-auto px-4 md:px-8 py-12 lg:py-16 md:mt-20">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-4 mb-8">
    <div>
      <p class="font-allura text-2xl md:text-3xl mb-1 leading-none" style="color: #E57B3E;">
        Trải nghiệm thú vị
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-4xl font-extrabold text-travel-primary">
        Tất cả trải nghiệm tại Nha Trang
      </h2>
    </div>
    <p class="text-sm text-gray-500 font-medium">Hiển thị 1–12 trong 86 trải nghiệm</p>
  </div>

  <div class="w-full">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 lg:gap-6">
      
      {experiences.map((exp) => (
        <div class="bg-white rounded-[24px] border border-gray-100 overflow-hidden hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-all group flex flex-col h-full">
          
          <!-- Image Area -->
          <div class="relative h-48 overflow-hidden shrink-0">
            <SafeImage 
              src={exp.image} 
              alt={exp.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              ratio="4:3"
            />
            
            <!-- Badge -->
            {exp.badge && (
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-lg text-[10px] font-bold text-gray-900 uppercase tracking-wide">
                {exp.badge}
              </div>
            )}

            <!-- Heart Button -->
            <button class="absolute top-3 right-3 w-8 h-8 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-400 hover:text-red-500 hover:scale-110 transition-all">
              <Icon name="lucide:heart" class="w-4 h-4" />
            </button>
          </div>

          <!-- Content Area -->
          <div class="p-5 flex flex-col flex-1">
            <h3 class="text-base font-bold text-gray-900 leading-tight mb-2 line-clamp-2">
              {exp.title}
            </h3>
            
            <div class="flex items-center gap-1.5 text-gray-500 text-xs mb-3">
              <Icon name="lucide:map-pin" class="w-3.5 h-3.5 shrink-0" />
              <span class="truncate">{exp.location}</span>
            </div>
            
            <p class="text-xs text-gray-600 line-clamp-2 mb-4 leading-relaxed">
              {exp.description}
            </p>

            <!-- Footer info (pushed to bottom) -->
            <div class="mt-auto space-y-3 pt-3 border-t border-gray-50">
              <!-- Meta -->
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-gray-600">
                <div class="flex items-center gap-1.5">
                  <Icon name="lucide:clock" class="w-3.5 h-3.5 text-gray-400" />
                  {exp.duration}
                </div>
                <div class="flex items-center gap-1">
                  <Icon name="lucide:star" class="w-3 h-3 fill-current text-[#F59E0B]" />
                  <span class="font-bold text-gray-900">{exp.rating}</span>
                  <span class="text-gray-400">({exp.reviews})</span>
                </div>
              </div>
              
              <!-- Price & Action -->
              <div class="flex items-center justify-between pt-1">
                <div>
                  <span class="text-base font-extrabold" style="color: #E57B3E;">{exp.price}</span>
                  <span class="text-[10px] text-gray-400 font-medium"> / người</span>
                </div>
                <button class="w-7 h-7 rounded-full bg-[#FCFAF5] flex items-center justify-center text-travel-primary group-hover:bg-travel-primary group-hover:text-white transition-colors">
                  <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </div>
</section>
