---
// HotelSearchPanel.astro
import DateRangePicker from "../shared/DateRangePicker.astro";
import Select from "../shared/Select.astro";
---

<div class="grid grid-cols-1 md:flex md:flex-wrap gap-3 items-end">
  <div class="md:flex-1 md:min-w-[180px]">
    <Select
      label="Địa điểm"
      name="hotel-location"
      placeholder="Nha Trang"
      searchable={false}
      icon='<svg class="w-4 h-4 text-travel-primary/50 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>'
      options={[
        { value: "nha-trang", label: "Nha Trang" },
        { value: "da-lat", label: "Đà Lạt" },
        { value: "phu-quoc", label: "Phú Quốc" },
        { value: "da-nang", label: "Đà Nẵng" },
        { value: "ho-chi-minh", label: "TP. Hồ Chí Minh" },
        { value: "ha-noi", label: "Hà Nội" },
        { value: "hue", label: "Huế" },
        { value: "hoi-an", label: "Hội An" },
      ]}
    />
  </div>

  <!-- Nhận phòng → Trả phòng (range) -->
  <div class="md:min-w-[280px]">
    <DateRangePicker
      name="hotel-dates"
      mode="range"
      labelFrom="Nhận phòng"
      labelTo="Trả phòng"
      placeholderFrom="Chọn ngày"
      placeholderTo="Chọn ngày"
    />
  </div>

  <div class="md:min-w-[140px]">
    <Select
      label="Phòng & Khách"
      name="hotel-rooms"
      searchable={false}
      placeholder="Chọn"
      icon='<svg class="w-4 h-4 text-travel-primary/50 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9,22 9,12 15,12 15,22"></polyline></svg>'
      options={[
        { value: "1-2", label: "1 phòng, 2 khách" },
        { value: "1-3", label: "1 phòng, 3 khách" },
        { value: "2-4", label: "2 phòng, 4 khách" },
        { value: "2-6", label: "2 phòng, 6 khách" },
        { value: "3-6", label: "3 phòng, 6 khách" },
      ]}
    />
  </div>

  <!-- Nút tìm -->
  <button
    class="shrink-0 w-full md:w-[48px] h-[42px] md:h-[48px] rounded-xl md:rounded-full bg-amber-600 text-white flex items-center justify-center gap-2 hover:bg-amber-700 active:scale-95 md:active:scale-90 transition-all shadow-lg shadow-amber-600/30"
    aria-label="Tìm khách sạn"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
    <span class="text-sm font-semibold md:hidden">Tìm khách sạn</span>
  </button>
</div>
