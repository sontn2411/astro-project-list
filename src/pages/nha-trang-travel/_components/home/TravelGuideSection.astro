---
import SafeImage from "../../../../components/SafeImage.astro";
import { Icon } from "astro-icon/components";

const guides = [
  {
    image: "https://images.unsplash.com/photo-1596422846543-73c383e60155?w=600&h=400&fit=crop",
    title: "Kinh nghiệm du lịch Nha Trang tự túc từ A-Z mới nhất 2026",
    desc: "Tổng hợp toàn bộ kinh nghiệm đi lại, ăn ở và vui chơi tại Nha Trang chi tiết nhất dành cho người đi lần đầu.",
    date: "15 Thg 7, 2026",
    category: "Kinh nghiệm"
  },
  {
    image: "https://images.unsplash.com/photo-1549488344-1f9b8d2bd1f3?w=600&h=400&fit=crop",
    title: "Top 10 quán hải sản ngon, bổ, rẻ không thể bỏ qua",
    desc: "Khám phá bản đồ ẩm thực hải sản tươi sống cực chất lượng được người dân địa phương yêu thích.",
    date: "10 Thg 7, 2026",
    category: "Ẩm thực"
  },
  {
    image: "https://images.unsplash.com/photo-1616190989396-857e2d93e18f?w=600&h=400&fit=crop",
    title: "Check-in 5 hòn đảo đẹp nhất vịnh Nha Trang",
    desc: "Hòn Mun, Hòn Tằm, Đảo Khỉ... đâu là điểm đến lý tưởng nhất cho chuyến đi của bạn? Cùng tìm hiểu nhé.",
    date: "05 Thg 7, 2026",
    category: "Điểm đến"
  }
];
---

<section class="py-5 md:py-10 px-4">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 md:mb-12">
      <div>
        <p class="font-allura text-xl md:text-2xl text-amber-500 italic mb-2">
          Góc chia sẻ
        </p>
        <h2 class="text-2xl md:text-4xl font-bold text-travel-primary">
          Cẩm nang du lịch
        </h2>
      </div>
      
      <a
        href="#guides"
        class="inline-flex items-center gap-2 text-sm md:text-base font-semibold text-travel-primary hover:text-amber-500 transition-colors group"
      >
        Xem tất cả bài viết
        <Icon
          name="lucide:arrow-right"
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>

    <!-- Editorial Bento Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
      
      <!-- Featured Article (Left, 7 cols) -->
      <a href="#" class="lg:col-span-7 group relative flex flex-col justify-end min-h-[420px] lg:min-h-[540px] rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500">
        <!-- Image & Gradient -->
        <SafeImage 
          src={guides[0].image} 
          alt={guides[0].title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
        
        <!-- Content Overlay -->
        <div class="relative z-10 p-6 md:p-10 flex flex-col">
          <div class="flex items-center gap-3 text-white/90 mb-4 text-xs md:text-sm font-medium">
            <span class="bg-amber-500 text-white px-3 py-1 rounded-full">{guides[0].category}</span>
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="w-4 h-4"/> 
              {guides[0].date}
            </span>
          </div>
          
          <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 md:mb-4 leading-snug group-hover:text-amber-400 transition-colors">
            {guides[0].title}
          </h3>
          
          <p class="text-white/80 line-clamp-2 md:text-lg mb-6 max-w-2xl font-light">
            {guides[0].desc}
          </p>
          
          <div class="inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:text-amber-400 transition-colors">
            Đọc chi tiết
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>
      </a>

      <!-- Secondary Articles (Right, 5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6 md:gap-8">
        {guides.slice(1).map((guide) => (
          <a href="#" class="group flex flex-col sm:flex-row gap-5 bg-white p-4 rounded-3xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-lg transition-all duration-300 flex-1">
            <!-- Thumbnail -->
            <div class="shrink-0 w-full sm:w-[180px] lg:w-[150px] xl:w-[180px] h-[220px] sm:h-full min-h-[160px] rounded-2xl overflow-hidden relative">
              <SafeImage 
                src={guide.image} 
                alt={guide.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur text-travel-primary text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                {guide.category}
              </div>
            </div>
            
            <!-- Content -->
            <div class="flex flex-col justify-center flex-1 py-1 pr-2">
              <div class="flex items-center gap-1.5 text-[11px] font-medium text-gray-500 mb-2.5">
                <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                <span>{guide.date}</span>
              </div>
              
              <h3 class="text-base md:text-lg font-bold text-gray-900 leading-tight mb-2 group-hover:text-travel-primary transition-colors line-clamp-3">
                {guide.title}
              </h3>
              
              <p class="text-xs text-gray-600 line-clamp-2 mb-4 leading-relaxed">
                {guide.desc}
              </p>
              
              <div class="mt-auto inline-flex items-center gap-1.5 text-[11px] font-semibold text-travel-primary group-hover:text-amber-500 transition-colors">
                Đọc tiếp
                <Icon name="lucide:arrow-right" class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
