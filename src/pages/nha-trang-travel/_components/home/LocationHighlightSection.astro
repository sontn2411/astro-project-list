---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import bg1 from "../../_assets/images/background1.png";
import tramHuong from "../../_assets/images/tram-huong.png";
import hoasen from "../../_assets/images/hoa-sen.png";

const locations = [
  {
    name: "Vịnh Nha Trang",
    desc: "Một trong 29 vịnh đẹp nhất thế giới",
    image:
      "https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?w=400&h=500&fit=crop",
  },
  {
    name: "Tháp Bà Ponagar",
    desc: "Di tích Chăm Pa hơn 1000 năm tuổi",
    image:
      "https://images.unsplash.com/photo-1583417319070-4a69db38a482?w=400&h=500&fit=crop",
  },
  {
    name: "Hòn Chồng",
    desc: "Kỳ quan đá tự nhiên độc đáo",
    image:
      "https://images.unsplash.com/photo-1537956965359-7573183d1f57?w=400&h=500&fit=crop",
  },
  {
    name: "Đảo Bình Ba",
    desc: "Thiên đường tôm hùm Khánh Hòa",
    image:
      "https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=400&h=500&fit=crop",
  },
];
---

<section class="py-6 md:py-14 px-4">
  <div
    class="relative max-w-7xl mx-auto bg-[#0e2e25] rounded-2xl md:rounded-3xl overflow-hidden py-6"
  >
    <!-- Họa tiết Tháp Trầm Hương -->
    <Image
      src={tramHuong}
      alt=""
      class="absolute left-[10%] bottom-0 w-48 object-contain pointer-events-none select-none opacity-100"
      loading="lazy"
    />
    <Image
      src={hoasen}
      alt=""
      class="absolute right-[20%] bottom-0 object-contain pointer-events-none select-none"
      loading="lazy"
    />

    <!-- Layout -->
    <div class="flex flex-col md:flex-row md:items-stretch">
      <!-- Title + CTA -->
      <div
        class="relative z-10 px-5 pt-5 pb-1 md:px-8 md:py-12 md:w-[300px] shrink-0 flex md:flex-col justify-between md:justify-center items-end md:items-start gap-2"
      >
        <div>
          <p class="font-allura text-lg md:text-2xl text-amber-400 italic">
            Địa danh nổi tiếng
          </p>
          <h2
            class="mt-1 md:mt-2 text-base md:text-2xl font-bold text-white leading-snug whitespace-nowrap md:whitespace-normal"
          >
            <span class="md:hidden">Khám phá Nha Trang</span>
            <span class="hidden md:inline"
              >Hành trình khám phá<br />Nha Trang</span
            >
          </h2>
        </div>
        <a
          href="#explore"
          class="shrink-0 inline-flex items-center gap-1.5 mb-1 md:mb-0 px-4 py-1.5 md:py-2 md:mt-5 border border-white/30 text-white text-xs md:text-sm font-semibold rounded-full hover:bg-white/10 transition-all duration-200 group whitespace-nowrap"
        >
          Xem thêm
          <Icon
            name="lucide:arrow-right"
            class="w-3.5 h-3.5 md:w-4 md:h-4 transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>

      <!-- Swiper Slider -->
      <div class="flex-1 overflow-hidden py-3 md:py-8 px-5 md:px-0">
        <div class="swiper location-swiper">
          <div class="swiper-wrapper">
            {
              locations.map((loc) => (
                <div class="swiper-slide md:!w-[220px]">
                  <div class="group cursor-pointer">
                    <div class="relative aspect-square rounded-2xl overflow-hidden">
                      <img
                        src={loc.image}
                        alt={loc.name}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        loading="lazy"
                      />
                    </div>
                    <div class="mt-3 px-1">
                      <h3 class="text-sm font-bold text-white">{loc.name}</h3>
                      <p class="text-xs text-white/50 mt-0.5">{loc.desc}</p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Autoplay } from "swiper/modules";
  import "swiper/css";

  new Swiper(".location-swiper", {
    modules: [Navigation, Autoplay],
    slidesPerView: 1,
    spaceBetween: 16,
    grabCursor: true,
    loop: true,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    navigation: {
      prevEl: ".location-prev",
      nextEl: ".location-next",
    },
    breakpoints: {
      768: {
        slidesPerView: "auto",
      },
    },
  });
</script>
