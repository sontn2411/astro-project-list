---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import capTreo from "../../_assets/images/cap-treo.jpg";

const offers = [
  {
    icon: "lucide:plane",
    title: "Ưu đãi vé máy bay",
    discount: "30%",
    code: "FLY30",
    expiry: "31/12/2026",
    iconColor: "text-travel-primary",
    iconBg: "bg-travel-primary/10",
    textColor: "text-amber-600",
  },
  {
    icon: "lucide:building-2",
    title: "Ưu đãi khách sạn",
    discount: "25%",
    code: "STAY25",
    expiry: "31/12/2026",
    iconColor: "text-travel-primary",
    iconBg: "bg-travel-primary/10",
    textColor: "text-amber-600",
  },
  {
    icon: "lucide:gift",
    title: "Trải nghiệm đặc sắc",
    discount: "20%",
    code: "FUN20",
    expiry: "31/12/2026",
    iconColor: "text-amber-600",
    iconBg: "bg-amber-600/10",
    textColor: "text-amber-600",
  },
];
---

<section class="py-6 md:py-14 px-4">
  <div class="relative max-w-7xl mx-auto bg-[#E8F4F8] min-h-[300px] rounded-3xl md:rounded-[2.5rem] overflow-hidden flex flex-col lg:flex-row items-center p-6 md:p-12 gap-8 shadow-sm">
    
    <!-- Background Image Left -->
    <div class="absolute left-0 bottom-0 top-0 w-[40%] md:w-[35%] opacity-50 mix-blend-multiply pointer-events-none">
      <Image 
        src={capTreo} 
        alt="" 
        class="w-full h-full object-cover mask-image-to-r" 
        loading="lazy" 
      />
    </div>

    <!-- Left Content: Text & CTA -->
    <div class="relative z-10 flex-1 pl-4 md:pl-10 lg:pl-32 max-w-xl text-center md:text-left mb-8 lg:mb-0">
      <p class="font-allura text-2xl md:text-3xl text-amber-600 italic mb-2">
        Ưu đãi đặc biệt
      </p>
      <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-travel-primary leading-snug mb-6">
        Ưu đãi lên đến 30%<br />cho hành trình của bạn
      </h2>
      <a
        href="#offers"
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#D97736] hover:bg-[#C2652B] text-white text-sm md:text-base font-semibold rounded-full transition-colors group"
      >
        Xem ưu đãi
        <Icon
          name="lucide:arrow-right"
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>

    <!-- Right Content: Cards -->
    <div class="relative z-10 flex flex-row gap-4 shrink-0 w-full lg:w-auto overflow-x-auto pb-4 snap-x snap-mandatory hide-scrollbar">
      {offers.map((offer) => (
        <a href="#" class="group shrink-0 w-[240px] sm:w-[210px] snap-center sm:snap-start bg-white/70 backdrop-blur-sm rounded-3xl p-5 border border-white/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:bg-white hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <!-- Icon & Title Row -->
          <div class="flex items-center gap-3 mb-4">
            <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${offer.iconBg} ${offer.iconColor}`}>
              <Icon name={offer.icon} class="w-5 h-5" />
            </div>
            <h3 class="text-sm font-semibold text-gray-800 leading-tight">
              {offer.title}
            </h3>
          </div>
          
          <!-- Discount & Code -->
          <div class="mb-5">
            <p class="text-[11px] text-gray-500 mb-0.5">Giảm đến</p>
            <p class={`text-3xl md:text-4xl font-bold ${offer.textColor} mb-3`}>
              {offer.discount}
            </p>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/50 border border-dashed border-gray-300 rounded-lg text-[11px] font-mono text-gray-600">
              Mã: <span class="font-bold text-travel-primary">{offer.code}</span>
            </div>
          </div>
          
          <!-- Action & Expiry -->
          <div class="mt-auto flex flex-col gap-2 border-t border-gray-100/50 pt-4">
            <div class="flex items-center justify-between text-[11px] font-semibold text-gray-600 group-hover:text-travel-primary transition-colors">
              <span>Đặt ngay</span>
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </div>
            <p class="text-[10px] text-gray-400 font-medium">HSD: {offer.expiry}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mask-image-to-r {
    mask-image: linear-gradient(to right, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 50%, transparent 100%);
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
