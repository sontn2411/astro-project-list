---
// WhyChooseUs.astro — Section "Tại sao chọn chúng tôi"
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "lucide:gift",
    title: "Giá tốt mỗi ngày",
    desc: "Cam kết mức giá tốt nhất cho bạn",
  },
  {
    icon: "lucide:leaf",
    title: "Trải nghiệm bản địa",
    desc: "Kết nối với văn hóa và con người Việt Nam",
  },
  {
    icon: "lucide:shield-check",
    title: "An tâm tuyệt đối",
    desc: "Hỗ trợ 24/7 trong suốt hành trình của bạn",
  },
  {
    icon: "lucide:calendar-plus",
    title: "Linh hoạt đặt dịch vụ",
    desc: "Dễ dàng thay đổi và hủy miễn phí",
  },
];
---

<section class="py-5 md:py-10 md:pt-20">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-y-5 md:gap-y-0">
      {
        features.map((f, i) => (
          <div
            class:list={[
              "flex items-start gap-3 md:gap-4 px-3 md:px-5",
              i > 0 && "md:border-l md:border-gray-200",
              i % 2 !== 0 &&
                "border-l border-gray-200 md:border-l md:border-gray-200",
            ]}
          >
            <div
              class:list={[
                "shrink-0 w-14 h-14 rounded-full border flex items-center justify-center",
                i % 2 === 0
                  ? "bg-travel-primary/8 border-travel-primary/15"
                  : "bg-amber-500/8 border-amber-500/15",
              ]}
            >
              <Icon
                name={f.icon}
                class:list={[
                  "w-6 h-6",
                  i % 2 === 0 ? "text-travel-primary/70" : "text-amber-600/70",
                ]}
                stroke-width="1.5"
              />
            </div>
            <div class="min-w-0">
              <h3 class="text-sm md:text-base font-bold text-gray-800 leading-snug">
                {f.title}
              </h3>
              <p class="text-xs md:text-sm text-gray-500 mt-0.5 leading-relaxed">
                {f.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
