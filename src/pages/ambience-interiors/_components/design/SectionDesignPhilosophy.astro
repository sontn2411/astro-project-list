---
import p1 from "../../_assets/design/philosophy-1.png";
import p2 from "../../_assets/design/philosophy-2.png";
import p3 from "../../_assets/design/philosophy-3.png";
---

<section class="py-16 pb-0 bg-white">
  <div class="relative">
    <div
      class="hidden md:block absolute top-1/2 -translate-y-1/2 w-full h-[32%] bg-ai-mocha/50"
    >
    </div>
    <!-- Header căn giữa -->
    <div class="px-4 md:px-0 max-w-3xl mx-auto text-center mb-10 md:mb-14">
      <!-- Subtitle hai vế -->
      <p class="text-xs tracking-[0.3em] text-gray-500 font-sans uppercase">
        Cao Cấp &amp; Thoải Mái
        <span class="mx-3 text-ai-mocha/60">/</span>
        Vượt Trội &amp; Độc Đáo
      </p>

      <!-- Title lớn có đường kẻ hai bên -->
      <div class="mt-4 hidden md:flex items-center justify-center gap-5">
        <div class="flex-1 h-px bg-gray-300"></div>
        <h2
          class="font-sans text-2xl md:text-3xl text-gray-800 whitespace-nowrap"
        >
          Vì Nghệ Thuật Mà Thiết Kế &nbsp;&nbsp; Vì Thiết Kế Mà Đẹp Hơn
        </h2>
        <div class="flex-1 h-px bg-gray-300"></div>
      </div>
      <h2 class="mt-4 md:hidden font-sans text-xl text-gray-800">
        Vì Nghệ Thuật Mà Thiết Kế &nbsp; Vì Thiết Kế Mà Đẹp Hơn
      </h2>
    </div>

    <div class="relative z-20 max-w-5xl mx-auto px-4 md:px-6">
      <!-- 2 cột nội dung -->
      <div class="grid grid-cols-1 md:grid-cols-[2fr_4fr] gap-10 items-center">
        <!-- Cột 1: 2 ảnh xếp dọc -->
        <div
          class="flex flex-col gap-6 md:gap-10 max-w-full md:max-w-[85%] md:ml-auto"
        >
          <!-- Ảnh trên -->
          <div class="overflow-hidden aspect-square">
            <img
              src={p3.src}
              alt="Triết lý thiết kế 3"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
          <!-- Ảnh dưới -->
          <div class="overflow-hidden">
            <img
              src={p1.src}
              alt="Triết lý thiết kế 1"
              class="w-full h-full object-contain hover:scale-105 transition-transform duration-700"
            />
          </div>
        </div>

        <!-- Cột 2: ảnh + title + desc -->
        <div class="flex flex-col items-start text-left gap-6">
          <!-- Ảnh giữa -->
          <div class="overflow-hidden w-full aspect-video">
            <img
              src={p2.src}
              alt="Triết lý thiết kế 2"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>

          <!-- Title & Desc -->
          <div class="max-w-sm px-4">
            <h3 class="font-sans text-xl text-gray-800">
              Nghệ Thuật Trong Từng Không Gian
            </h3>
            <p class="mt-3 text-sm text-gray-500 font-sans leading-relaxed">
              <!-- Nội dung sẽ thêm vào sau -->
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
