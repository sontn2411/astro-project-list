---
// Social sidebar — desktop only
---

<div
  class="hidden md:flex absolute left-5 top-1/2 -translate-y-1/2 flex-col items-center gap-4 z-10"
>
  <!-- "Follow us" text dọc -->
  <span
    class="[writing-mode:vertical-rl] rotate-180 text-[10px] tracking-[0.25em] text-gray-600/60 uppercase font-sans"
  >
    Follow us
  </span>

  <!-- Đường kẻ -->
  <div class="w-px h-6 bg-gray-600/30"></div>

  <!-- Facebook -->
  <a
    href="#"
    aria-label="Facebook"
    class="text-white hover:text-ai-mocha transition-colors duration-200"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
      ></path>
    </svg>
  </a>

  <!-- TikTok -->
  <a
    href="#"
    aria-label="TikTok"
    class="text-white hover:text-ai-mocha transition-colors duration-200"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.69a8.22 8.22 0 0 0 4.83 1.56V6.8a4.85 4.85 0 0 1-1.07-.11z"
      ></path>
    </svg>
  </a>

  <!-- X (Twitter) -->
  <a
    href="#"
    aria-label="X"
    class="text-white hover:text-ai-mocha transition-colors duration-200"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.745l7.73-8.835L1.254 2.25H8.08l4.263 5.637z"
      ></path>
    </svg>
  </a>
</div>
