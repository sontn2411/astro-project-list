---
import SafeImage from "../../../../components/SafeImage.astro";
import image1 from "../../_assets/product-hot-1.png";
import image2 from "../../_assets/product-hot-2.png";
import image3 from "../../_assets/product-hot-3.png";
import image4 from "../../_assets/product-hot-4.png";
import SectionTitle from "../SectionTitle.astro";

const products = [
  {
    id: 1,
    title: "Sofa Góc Bắc Âu",
    price: "12.500.000 ₫",
    image: image1,
  },
  {
    id: 2,
    title: "Bàn Ăn Walnut",
    price: "8.900.000 ₫",
    image: image2,
  },
  {
    id: 3,
    title: "Giường Oak Cao Cấp",
    price: "15.200.000 ₫",
    image: image3,
  },
  {
    id: 4,
    title: "Tủ Bếp Tần Bì",
    price: "21.000.000 ₫",
    image: image4,
  },
];
---

<section class="py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <SectionTitle subtitle="Bộ sưu tập" title="Sản Phẩm Nổi Bật" />

    <!-- Product grid xen kẽ -->
    <div
      class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-14 pb-10 px-4 md:px-10 mt-4 md:mt-20"
    >
      {
        products.map((p, i) => {
          const isShifted = i % 2 === 1; // index 1, 3 → dịch xuống
          return (
            <div class={`flex flex-col ${isShifted ? "md:mt-10" : "mt-0"}`}>
              {/* Text trên ảnh — chỉ trên desktop với item chẵn */}
              {isShifted && (
                <div class="hidden md:flex items-baseline justify-between mb-4 px-1">
                  <span class="text-sm text-gray-700 font-sans">{p.title}</span>
                  <span class="text-sm text-ai-mocha font-sans tabular-nums">
                    {p.price}
                  </span>
                </div>
              )}

              {/* Card wrapper + decorative border lệch */}
              <div class="relative">
                {/* Border trang trí lệch */}
                <div
                  class={`absolute top-0 bottom-0 -left-[6%] w-[112%] border border-ai-mocha/50 pointer-events-none z-30 ${
                    !isShifted ? "md:-translate-y-5" : "md:translate-y-5"
                  }`}
                />
                {/* Card ảnh */}
                <div class="relative z-20 bg-[#f8f6f2] overflow-hidden aspect-[4/6]">
                  <SafeImage
                    src={p.image.src}
                    alt={p.title}
                    class="w-full h-full object-contain p-6 transition-transform duration-500 hover:scale-105"
                  />
                </div>
              </div>

              {/* Text dưới ảnh — luôn hiện trên mobile; desktop chỉ cho item lẻ */}
              <div
                class={`flex items-baseline justify-between mt-4 px-1 ${isShifted ? "md:hidden" : ""}`}
              >
                <span class="text-sm text-gray-700 font-sans">{p.title}</span>
                <span class="text-sm text-ai-mocha font-sans tabular-nums">
                  {p.price}
                </span>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
