---
interface Props {
  images: string[];
  galleryId: number;
  name: string;
  autoInterval?: number; // ms, mặc định 2500
}

const { images, galleryId, name, autoInterval = 2500 } = Astro.props;
---

<div class="flex flex-col items-center" data-gallery-root={galleryId}>
  <!-- Vòng tròn + ảnh lớn -->
  <div
    class="relative w-64 h-64 md:w-[500px] md:h-[500px] lg:w-[560px] lg:h-[560px] rounded-full bg-white/40 flex items-center justify-center"
  >
    <!-- Dashed ring trang trí -->
    <div
      class="absolute inset-4 rounded-full border border-dashed border-ai-mocha/30 pointer-events-none"
    >
    </div>

    <!-- Ảnh active -->
    <img
      src={images[0]}
      alt={`${name} view 1`}
      class="main-img w-full h-full object-contain p-6 md:p-8 transition-opacity duration-300"
      data-gallery={galleryId}
    />
  </div>

  <!-- Thumbnails — ẩn trên mobile -->
  <div class="hidden md:flex gap-3 mt-5">
    {
      images.map((img, j) => (
        <button
          class="thumb-btn w-16 h-16 rounded-lg overflow-hidden transition-all duration-200 "
          data-gallery={galleryId}
          data-thumb={j}
          data-src={img}
          aria-label={`Xem ảnh ${j + 1}`}
        >
          <img
            src={img}
            alt={`${name} ${j + 1}`}
            class="w-full h-full object-cover"
          />
        </button>
      ))
    }
  </div>
</div>

<script define:vars={{ galleryId, autoInterval }}>
  function initGalleryAuto() {
    const root = document.querySelector(`[data-gallery-root="${galleryId}"]`);
    const mainImg = root?.querySelector(
      `.main-img[data-gallery="${galleryId}"]`,
    );
    const thumbs = Array.from(
      root?.querySelectorAll(`.thumb-btn[data-gallery="${galleryId}"]`) ?? [],
    );

    if (!root || !mainImg || thumbs.length === 0) return;

    let current = 0;
    let timer;

    function activateThumb(idx) {
      const btn = thumbs[idx];
      const src = btn?.dataset.src;
      if (!src) return;

      // Đổi ảnh lớn với fade
      mainImg.style.opacity = "0";
      setTimeout(() => {
        mainImg.src = src;
        mainImg.style.opacity = "1";
      }, 150);

      current = idx;
    }

    function startAuto() {
      timer = setInterval(() => {
        activateThumb((current + 1) % thumbs.length);
      }, autoInterval);
    }

    function stopAuto() {
      clearInterval(timer);
    }

    // Click thủ công
    thumbs.forEach((btn, j) => {
      btn.addEventListener("click", () => {
        stopAuto();
        activateThumb(j);
        startAuto();
      });
    });

    // Pause khi hover
    root.addEventListener("mouseenter", stopAuto);
    root.addEventListener("mouseleave", startAuto);

    startAuto();
  }

  initGalleryAuto();
  document.addEventListener("astro:after-swap", initGalleryAuto);
</script>
