---
import HeroGallery from "./HeroGallery.astro";

interface SlideData {
  id: number;
  name: string;
  desc?: string;
  price: string;
  images: string[];
}

interface Props {
  slide: SlideData;
  index: number;
  isActive: boolean;
}

const { slide, index, isActive } = Astro.props;
const hasImages = slide.images.length > 0;
---

<div
  data-slide={index}
  class={`hero-slide absolute inset-0 flex flex-col justify-center md:flex-row md:items-center transition-all duration-700 ease-in-out ${
    isActive
      ? "opacity-100 translate-y-0"
      : "opacity-0 translate-y-8 pointer-events-none"
  }`}
>
  {
    hasImages ? (
      <div class="w-full flex flex-col gap-5 md:grid md:grid-cols-2 md:gap-8 md:items-center md:px-16 md:h-full">
        {/* ── Mobile: gallery trên ── Desktop: gallery phải (order-2) ── */}
        <div class="order-1 md:order-2 flex justify-center">
          <HeroGallery
            images={slide.images}
            galleryId={index}
            name={slide.name}
          />
        </div>

        {/* ── Mobile: text dưới ── Desktop: text trái (order-1) ── */}
        <div class="order-2 md:order-1 flex flex-col items-center md:items-start text-center md:text-left px-6 md:px-0 pb-16 md:pb-0">
          {/* Title */}
          <h1 class="font-sans text-4xl md:text-6xl lg:text-7xl text-gray-800 leading-tight tracking-tight">
            {slide.name}
          </h1>

          {/* Desc (tuỳ chọn) */}
          {slide.desc && (
            <p class="mt-3 text-sm sm:text-base text-gray-800 font-sans leading-relaxed max-w-xs">
              {slide.desc}
            </p>
          )}

          {/* Divider */}
          <div class="mt-4 w-12 h-px bg-ai-mocha" />

          {/* Price */}
          <p class="mt-4 text-lg md:text-2xl font-sans font-bold text-ai-mocha">
            {slide.price}
          </p>

          {/* Button */}
          <a
            href="/ambience-interiors/products/"
            class="mt-4 inline-flex items-center gap-2 self-center md:self-start px-6 py-2.5 bg-ai-mocha text-white text-sm font-sans  hover:bg-ai-mocha/90 transition-colors duration-200"
          >
            Xem ngay
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="w-full flex flex-col items-center justify-center text-center px-6 h-full">
        <h1 class="font-sans text-5xl md:text-8xl lg:text-9xl text-gray-800 leading-none tracking-tight">
          {slide.name}
        </h1>
        <p class="mt-4 text-sm md:text-base font-sans text-ai-mocha/80 tracking-widest">
          {slide.price}
        </p>
        <div class="mt-6 w-16 h-px bg-ai-mocha" />
      </div>
    )
  }
</div>
