---
const navColumns = [
  {
    heading: "Về Chúng Tôi",
    links: [
      { label: "Dịch vụ", href: "/ambience-interiors/about/" },
      { label: "Giới thiệu thương hiệu", href: "/ambience-interiors/about/" },
      { label: "Câu chuyện thương hiệu", href: "/ambience-interiors/about/" },
      { label: "Triết lý thương hiệu", href: "/ambience-interiors/about/" },
      { label: "Đội ngũ thiết kế", href: "/ambience-interiors/about/" },
    ],
  },
  {
    heading: "Sản Phẩm",
    links: [
      { label: "Sản phẩm nổi bật", href: "/ambience-interiors/products/" },
      { label: "Sản phẩm mới", href: "/ambience-interiors/products/" },
      { label: "Dòng sản phẩm", href: "/ambience-interiors/products/" },
      { label: "Phân loại sản phẩm", href: "/ambience-interiors/products/" },
    ],
  },
  {
    heading: "Thiết Kế",
    links: [
      { label: "Tinh hoa thiết kế", href: "/ambience-interiors/design/" },
      { label: "Quy trình thiết kế", href: "/ambience-interiors/design/" },
      { label: "Thiết kế riêng", href: "/ambience-interiors/design/" },
    ],
  },
  {
    heading: "Tin Tức",
    links: [
      { label: "Tin liên quan", href: "/ambience-interiors/news/" },
      { label: "Đề xuất hàng ngày", href: "/ambience-interiors/news/" },
    ],
  },
];
---

<footer class="bg-ai-mocha text-white/80">
  <div class="max-w-7xl mx-auto px-6 pt-14 pb-8">
    <!-- Top grid: logo + nav columns + newsletter -->
    <div
      class="grid grid-cols-2 md:grid-cols-[160px_1fr_1fr_1fr_1fr_220px] gap-8 md:gap-6"
    >
      <!-- Logo -->
      <div class="col-span-2 md:col-span-1 flex items-start">
        <div class="text-white/80">
          <p
            class="font-sans text-sm font-semibold tracking-widest uppercase leading-none"
          >
            Ambience
          </p>
          <p
            class="font-sans text-xs tracking-[0.3em] uppercase text-white/50 mt-1"
          >
            Interiors
          </p>
        </div>
      </div>

      <!-- Nav columns -->
      {
        navColumns.map((col) => (
          <div>
            <h4 class="text-white text-sm font-sans mb-4">{col.heading}</h4>
            <ul class="space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-white/60 font-sans hover:text-white transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Newsletter + Social -->
      <div class="col-span-2 md:col-span-1">
        <!-- Email subscribe -->
        <div class="flex">
          <input
            type="email"
            placeholder="Email của bạn"
            class="flex-1 min-w-0 bg-white border border-white/20 px-3 py-2 text-xs text-black placeholder-black font-sans outline-none transition-colors"
          />
          <button
            class="px-4 py-2 bg-white/15 border border-white/20 border-l-0 text-xs text-white font-sans uppercase tracking-[0.15em] hover:bg-white/25 transition-colors"
          >
            Đăng ký
          </button>
        </div>

        <!-- Social -->
        <div class="mt-6 flex items-center gap-4">
          <span class="text-xs text-white/60 font-sans">Theo dõi chúng tôi</span
          >
          <!-- Facebook -->
          <a
            href="#"
            aria-label="Facebook"
            class="text-white/60 hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path>
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href="#"
            aria-label="Instagram"
            class="text-white/60 hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <rect x="2" y="2" width="20" height="20" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle
                cx="17.5"
                cy="6.5"
                r="0.8"
                fill="currentColor"
                stroke="none"></circle>
            </svg>
          </a>
          <!-- TikTok -->
          <a
            href="#"
            aria-label="TikTok"
            class="text-white/60 hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.95a8.16 8.16 0 0 0 4.78 1.53V7.02a4.85 4.85 0 0 1-1.01-.33z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-12 border-t border-white/20"></div>

    <!-- Copyright -->
    <div
      class="mt-5 flex flex-col md:flex-row items-center justify-between gap-2"
    >
      <p class="text-xs text-white/40 font-sans">
        © 2026 Ambience Interiors. All Rights Reserved.
      </p>
      <p class="text-xs text-white/40 font-sans">
        Thiết kế & Phát triển bởi Ambience Team
      </p>
    </div>
  </div>
</footer>
