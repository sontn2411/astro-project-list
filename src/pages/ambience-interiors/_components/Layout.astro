---
import Layout from "../../../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import BannerHero from "./home/BannerHero.astro";

interface Props {
  title: string;
  desc?: string;
}

const { title, desc } = Astro.props;
---

<Layout title={title} description={desc}>
  <!-- Inject Google Fonts chỉ cho project này -->
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Mulish:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <Header />

  <main transition:animate="fade" class="font-sans space-y-10 mb-20">
    <BannerHero />
    <slot />
  </main>

  <Footer />
</Layout>
