---
import SafeImage from "../components/SafeImage.astro";
import Layout from '../layouts/Layout.astro';
import ambienceImg from '../assets/project-ambience-thumbnail.png';

const projects = [
  {
    slug: 'ambience-interiors',
    name: 'Ambience Interiors',
    category: 'Nội thất',
    year: '2024',
    tags: ['Interior', 'Luxury', 'Residential'],
    description: 'Thương hiệu thiết kế nội thất cao cấp, tinh tế và sang trọng. Website, nhận diện thương hiệu và catalog sản phẩm.',
    thumbnail: ambienceImg.src,
    status: 'Đang phát triển',
    progress: 70,
    index: '01',
  },
  {
    slug: 'nha-trang-travel',
    name: 'Nha Trang Travel',
    category: 'Thương mại điện tử',
    year: '2024',
    tags: ['E-commerce', 'UI/UX', 'Brand'],
    description: 'Nền tảng thương mại điện tử hiện đại, tối ưu trải nghiệm người dùng và tỷ lệ chuyển đổi doanh số.',
    thumbnail: null,
    status: 'Đang phát triển',
    progress: null,
    index: '02',
  },
];

const categories = ['Tất cả', ...new Set(projects.map(p => p.category))];
const allTags = ['Tất cả', ...new Set(projects.flatMap(p => p.tags))];
---

<Layout title="Projects — Portfolio" description="Tổng hợp các dự án thiết kế và phát triển">
<style>
  /* ── CSS tokens ─────────────────────────────────────────── */
  :root {
    --bg:        #070D19;
    --surface:   #0D1829;
    --surface-2: #0F1A2E;
    --border:    #1E293B;
    --accent:    #10B981;
    --accent-fg: #030712;
    --text-1:    #F1F5F9;
    --text-2:    #94A3B8;
    --text-3:    #475569;
    --text-4:    #334155;
    --amber:     #FBBF24;
  }

  /* ── Filter button shared ───────────────────────────────── */
  .filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;          /* ≥ 36px → better touch target */
    padding: 0.25rem 0.875rem;
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-3);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    cursor: pointer;
    white-space: nowrap;
  }
  .filter-btn:hover { border-color: var(--text-2); color: var(--text-1); }
  .filter-btn.active {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
    font-weight: 600;
  }

  /* ── Active filter indicator strip ─────────────────────── */
  .active-filters { display: none; }
  .active-filters.visible { display: flex; }
</style>

<main style="background: var(--bg); color: var(--text-1);" class="min-h-screen">

  <!-- ── Header (compact) ──────────────────────────────────── -->
  <header class="px-6 md:px-12 max-w-7xl mx-auto pt-12 pb-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <!-- P1 FIX: Branding + identity -->
      <div>
        <p class="text-[10px] tracking-[0.3em] uppercase mb-3" style="color: var(--accent);">Portfolio — Sweetsoft Studio</p>
        <h1 class="text-3xl md:text-4xl font-light tracking-tight leading-tight" style="color: var(--text-1);">Tất cả dự án</h1>
        <!-- P3 FIX: Tách count ra khỏi h1, không render vào heading string -->
        <p class="mt-1 text-xs" style="color: var(--text-3);">
          <span id="header-count">{projects.length}</span> dự án · cập nhật liên tục
        </p>
      </div>
      <p class="text-sm leading-relaxed max-w-[280px] sm:text-right" style="color: var(--text-3);">
        Thiết kế và phát triển web —
        <br class="hidden sm:block" />
        từ thương hiệu đến trải nghiệm người dùng.
      </p>
    </div>
    <div class="mt-6" style="border-top: 1px solid var(--border);"></div>
  </header>

  <!-- ── Controls ──────────────────────────────────────────── -->
  <div class="px-6 md:px-12 max-w-7xl mx-auto pt-5 pb-8">

    <!-- Row 1: Search + count -->
    <div class="flex items-center gap-4 mb-4">
      <div class="relative flex-1 max-w-sm">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 pointer-events-none" style="color: var(--text-3);" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
        </svg>
        <input
          id="project-search"
          type="text"
          placeholder="Tìm theo tên, danh mục, tag..."
          autocomplete="off"
          style="background: var(--surface-2); border: 1px solid var(--border); color: var(--text-1);"
          class="w-full text-sm pl-9 pr-4 py-2.5 focus:outline-none focus-visible:border-[--accent] focus:border-emerald-500 transition-colors rounded-none placeholder:text-[--text-3]"
        />
      </div>
      <span id="project-count" class="text-xs flex-shrink-0 ml-auto" style="color: var(--text-3);">
        {projects.length} dự án
      </span>
    </div>

    <!-- Row 2: Category filters -->
    <div class="flex flex-wrap gap-2 mb-3" id="category-filters">
      {categories.map((cat, i) => (
        <button
          data-filter={cat}
          data-type="category"
          class:list={['filter-btn', i === 0 ? 'active' : '']}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Row 3: Tag filters -->
    <div class="flex flex-wrap gap-2" id="tag-filters">
      {allTags.map((tag, i) => (
        <button
          data-filter={tag}
          data-type="tag"
          class:list={['filter-btn', i === 0 ? 'active' : '']}
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- Active filter strip (chỉ hiện khi đang filter) -->
    <div id="active-filter-strip" class="active-filters items-center gap-3 mt-4">
      <span class="text-[10px] tracking-wider uppercase" style="color: var(--text-3);">Đang lọc:</span>
      <span id="active-filter-label" class="text-[10px] px-2 py-1 border" style="color: var(--accent); border-color: var(--accent);"></span>
      <button id="clear-all-filters" class="text-[10px] underline underline-offset-2 ml-1" style="color: var(--text-3);">Xóa tất cả</button>
    </div>

  </div>

  <!-- ── Project Grid ──────────────────────────────────────── -->
  <div class="px-6 md:px-12 max-w-7xl mx-auto pb-24">
    <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <a
          href={`/${project.slug}/`}
          class="project-card group flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          style="background: var(--surface); border: 1px solid var(--border);"
          data-name={project.name.toLowerCase()}
          data-desc={project.description.toLowerCase()}
          data-category={project.category}
          data-tags={project.tags.join(',')}
        >
          <!-- Thumbnail -->
          <div class="relative w-full aspect-video overflow-hidden" style="background: var(--surface-2);">
            {project.thumbnail ? (
              <SafeImage
                src={project.thumbnail}
                alt={project.name}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-75 group-hover:opacity-100"
              />
            ) : (
              /* FIX P2: placeholder có hoa văn thay vì chữ cái đơn lẻ gần vô hình */
              <div class="w-full h-full flex flex-col items-center justify-center gap-2" style="background: linear-gradient(135deg, #0D1829 0%, #111827 50%, #0D1829 100%);">
                <svg class="w-10 h-10 opacity-20" style="color: var(--accent);" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="0" />
                  <path d="M3 9h18M9 21V9" />
                </svg>
                <span class="text-[10px] tracking-widest uppercase opacity-30" style="color: var(--text-2);">{project.category}</span>
              </div>
            )}

            <!-- Index badge -->
            <div class="absolute top-3 left-3 text-[10px] px-2 py-1 font-semibold tracking-widest" style="background: var(--accent); color: var(--accent-fg);">
              {project.index}
            </div>

            <!-- Status badge -->
            <div
              class="absolute top-3 right-3 text-[9px] px-2 py-1 tracking-wider uppercase border"
              style={project.status === 'Hoàn thành'
                ? 'color: var(--accent); border-color: var(--accent); background: rgba(16,185,129,0.1);'
                : 'color: var(--amber); border-color: var(--amber); background: rgba(251,191,36,0.1);'}
            >
              {project.status}
            </div>
          </div>

          <!-- Body -->
          <div class="p-6 flex flex-col gap-4 flex-1">
            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {project.tags.slice(0, 3).map(tag => (
                <span class="text-[9px] tracking-widest uppercase px-2 py-0.5 border" style="color: var(--text-3); border-color: var(--border);">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Title + Year -->
            <div>
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <h2 class="text-base font-normal leading-snug" style="color: var(--text-1);">
                  {project.name}
                </h2>
                <span class="text-[11px] flex-shrink-0" style="color: var(--text-4);">{project.year}</span>
              </div>
              <p class="text-xs leading-relaxed line-clamp-2" style="color: var(--text-2);">{project.description}</p>
            </div>

            <!-- Progress Bar -->
            {project.progress !== null && project.progress !== undefined && (
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[9px] tracking-widest uppercase" style="color: var(--text-3);">Tiến độ</span>
                  <span class="text-[11px] font-semibold" style="color: var(--accent);">{project.progress}%</span>
                </div>
                <div class="w-full h-[3px]" style="background: var(--border);">
                  <div class="h-[3px]" style={`width: ${project.progress}%; background: var(--accent);`}></div>
                </div>
              </div>
            )}

            <!-- CTA — FIX P3: dùng text-2 thay vì text-4 tàng hình -->
            <div class="flex items-center gap-2 mt-auto pt-3" style="border-top: 1px solid var(--border);">
              <span class="text-xs tracking-widest uppercase group-hover:text-emerald-400 transition-colors duration-200" style="color: var(--text-2);">
                Xem dự án
              </span>
              <svg
                class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-all duration-300"
                style="color: var(--accent);"
                fill="none" stroke="currentColor" viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>

          <!-- Bottom accent bar -->
          <div class="h-[2px] w-0 group-hover:w-full transition-all duration-500" style="background: var(--accent);"></div>
        </a>
      ))}
    </div>

    <!-- Empty State — P2 FIX: dynamic message phản chiếu search query -->
    <div id="empty-state" class="hidden flex-col items-center justify-center py-24 text-center">
      <svg class="w-10 h-10 mb-4 opacity-20" style="color: var(--text-3);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
      </svg>
      <p class="text-sm mb-1" style="color: var(--text-2);">Không tìm thấy kết quả cho <em id="empty-query" class="not-italic font-medium" style="color: var(--text-1);"></em></p>
      <p class="text-xs mb-4" style="color: var(--text-3);">Thử từ khóa khác hoặc xóa bộ lọc.</p>
      <button id="reset-filters" class="text-xs px-4 py-2 border transition-colors hover:bg-emerald-500 hover:border-emerald-500 hover:text-black" style="color: var(--accent); border-color: var(--accent);">
        Xóa bộ lọc
      </button>
    </div>
  </div>

</main>
</Layout>

<script>
  const searchInput = document.getElementById('project-search') as HTMLInputElement;
  const categoryButtons = document.querySelectorAll('[data-type="category"]') as NodeListOf<HTMLElement>;
  const tagButtons     = document.querySelectorAll('[data-type="tag"]')      as NodeListOf<HTMLElement>;
  const projectCards   = document.querySelectorAll('.project-card')          as NodeListOf<HTMLElement>;
  const countEl        = document.getElementById('project-count');
  const headerCountEl  = document.getElementById('header-count'); // P3 FIX
  const emptyState     = document.getElementById('empty-state');
  const emptyQueryEl   = document.getElementById('empty-query');   // P2 FIX
  const resetBtn       = document.getElementById('reset-filters');
  const clearAllBtn    = document.getElementById('clear-all-filters');
  const gridEl         = document.getElementById('project-grid');
  const activeStrip    = document.getElementById('active-filter-strip');
  const activeLbl      = document.getElementById('active-filter-label');

  let activeCategory = 'Tất cả';
  let activeTag      = 'Tất cả';
  let searchQuery    = '';

  function applyFilters() {
    let visible = 0;
    projectCards.forEach(card => {
      // FIX Minor: search cũng match description và tags
      const name  = card.dataset.name  || '';
      const desc  = card.dataset.desc  || '';
      const tags  = (card.dataset.tags || '').split(',');
      const cat   = card.dataset.category || '';
      const q     = searchQuery.toLowerCase();
      const matchSearch   = q === '' || name.includes(q) || desc.includes(q) || tags.some(t => t.toLowerCase().includes(q));
      const matchCategory = activeCategory === 'Tất cả' || cat === activeCategory;
      const matchTag      = activeTag === 'Tất cả' || tags.includes(activeTag);
      const ok = matchSearch && matchCategory && matchTag;
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });

    if (countEl) countEl.textContent = `${visible} dự án`;
    // P3 FIX: cập nhật header-count khi filter
    if (headerCountEl) headerCountEl.textContent = String(visible);

    // Empty state
    if (emptyState && gridEl) {
      const isEmpty = visible === 0;
      emptyState.classList.toggle('hidden', !isEmpty);
      emptyState.classList.toggle('flex', isEmpty);
      gridEl.classList.toggle('hidden', isEmpty);

      // P2 FIX: hiện query trong empty state
      if (isEmpty && emptyQueryEl) {
        const parts: string[] = [];
        if (searchQuery)                  parts.push(`"​${searchQuery}​"`);
        if (activeCategory !== 'Tất cả') parts.push(activeCategory);
        if (activeTag !== 'Tất cả')      parts.push(`#${activeTag}`);
        emptyQueryEl.textContent = parts.length ? parts.join(' · ') : 'bộ lọc hiện tại';
      }
    }

    // Active filter strip
    const isFiltering = activeCategory !== 'Tất cả' || activeTag !== 'Tất cả' || searchQuery !== '';
    if (activeStrip) {
      activeStrip.classList.toggle('visible', isFiltering);
    }
    if (activeLbl) {
      const parts: string[] = [];
      if (searchQuery)              parts.push(`"${searchQuery}"`);
      if (activeCategory !== 'Tất cả') parts.push(activeCategory);
      if (activeTag !== 'Tất cả')      parts.push(`#${activeTag}`);
      activeLbl.textContent = parts.join(' · ');
    }
  }

  function setActiveBtn(buttons: NodeListOf<HTMLElement>, val: string) {
    buttons.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.filter === val);
    });
  }

  function resetAll() {
    if (searchInput) searchInput.value = '';
    searchQuery    = '';
    activeCategory = 'Tất cả';
    activeTag      = 'Tất cả';
    setActiveBtn(categoryButtons, 'Tất cả');
    setActiveBtn(tagButtons, 'Tất cả');
    applyFilters();
  }

  // FIX Minor: search match description + tags (handled in applyFilters)
  searchInput?.addEventListener('input', e => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  categoryButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filter || 'Tất cả';
      setActiveBtn(categoryButtons, activeCategory);
      applyFilters();
    });
  });

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.filter || 'Tất cả';
      setActiveBtn(tagButtons, activeTag);
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', resetAll);
  clearAllBtn?.addEventListener('click', resetAll);
</script>
