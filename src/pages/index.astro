---
import Layout from '../layouts/Layout.astro';
import ambienceImg from '../assets/project-ambience-thumbnail.png';
import antiFoodImg from './anti-food/_assets/bg-banner.jpg';
import travelImg from './nha-trang-travel/_assets/images/banner-hero.png';
import lolImg from './league-of-legends/_assets/images/Runeterra_Terrain_map.png';

const projects = [
  {
    slug: 'anti-food',
    name: 'Anti Food',
    category: 'Nhà hàng & F&B',
    year: '2024',
    tags: ['Restaurant', 'Fine Dining', 'Gastronomy', 'UI/UX'],
    description: 'Trải nghiệm ẩm thực thượng hạng với phong cách sang trọng đương đại. Tích hợp thực đơn tương tác, đặt bàn online và thư viện trải nghiệm đa sắc.',
    thumbnail: antiFoodImg.src,
    status: 'Hoàn thành',
    badgeColor: 'emerald',
    index: '01',
    url: '/anti-food',
  },
  {
    slug: 'ambience-interiors',
    name: 'Ambience Interiors',
    category: 'Kiến trúc & Nội thất',
    year: '2024',
    tags: ['Interior', 'Luxury', 'Residential', 'Architecture'],
    description: 'Thương hiệu thiết kế nội thất cao cấp, tinh tế và sang trọng. Website, nhận diện thương hiệu độc bản và catalog dự án không gian sống.',
    thumbnail: ambienceImg.src,
    status: 'Hoàn thành',
    badgeColor: 'emerald',
    index: '02',
    url: '/ambience-interiors',
  },
  {
    slug: 'nha-trang-travel',
    name: 'Nha Trang Travel',
    category: 'Du lịch & Khám phá',
    year: '2024',
    tags: ['Travel', 'E-commerce', 'Booking', 'Interactive'],
    description: 'Nền tảng du lịch và đặt tour hiện đại tại Nha Trang: khám phá danh lam thắng cảnh, khách sạn nghỉ dưỡng và ẩm thực địa phương.',
    thumbnail: travelImg.src,
    status: 'Đang phát triển',
    badgeColor: 'amber',
    index: '03',
    url: '/nha-trang-travel',
  },
  {
    slug: 'league-of-legends',
    name: 'League of Legends',
    category: 'Game Showcase',
    year: '2024',
    tags: ['Gaming', 'Riot Games', 'Audio/Visual', 'Data Showcase'],
    description: 'Bách khoa toàn thư tra cứu hồ sơ hơn 160+ vị tướng Liên Minh Huyền Thoại với hiệu ứng thị giác đỉnh cao, âm thanh và hỗ trợ đa ngôn ngữ.',
    thumbnail: lolImg.src,
    status: 'Hoàn thành',
    badgeColor: 'emerald',
    index: '04',
    url: '/league-of-legends',
  },
];

const categories = ['Tất cả', ...new Set(projects.map(p => p.category))];
---

<Layout title="Projects I've Built — Portfolio" description="A collection of projects I've worked on, from web apps to creative tools.">
<style>
  html, body { 
    width: 100%; 
    min-height: 100%; 
    background: #070b0d; 
    color: #f3f4f6;
    overflow-x: hidden;
  }
  
  canvas { 
    display: block; 
    width: 100vw; 
    height: 100vh; 
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
  }

  .canvas-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    background: radial-gradient(circle at 50% 20%, transparent 35%, rgba(7, 9, 14, 0.75) 100%);
  }

  .project-card {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.35s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -15px rgba(129, 140, 248, 0.25);
    border-color: rgba(167, 139, 250, 0.4);
  }
</style>

<!-- Background Canvas & Overlay -->
<canvas id="canvas"></canvas>
<div class="canvas-overlay"></div>

<!-- Main Content Foreground -->
<main class="relative z-10 min-h-screen px-4 sm:px-6 md:px-8 lg:px-12 py-10 sm:py-16 md:py-20 max-w-7xl mx-auto w-full">
  
  <!-- Title & Description Section -->
  <section class="mb-10 md:mb-14">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-4">
      Projects <span class="bg-gradient-to-r from-[#c084fc] via-[#818cf8] to-[#93c5fd] bg-clip-text text-transparent">I’ve Built</span>
    </h1>
    
    <p class="text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed font-normal">
      Tổng hợp các dự án web application, thiết kế giao diện sáng tạo và trải nghiệm số đã thực hiện. Mỗi dự án là một bước tiến trong hành trình phát triển sản phẩm chất lượng cao.
    </p>

    <!-- Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 pt-6 sm:pt-8" id="category-filters">
      {categories.map((cat, i) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-4 py-1.5 text-xs sm:text-sm rounded-full font-medium transition-all duration-200 border cursor-pointer ${
            i === 0
              ? 'bg-violet-600/30 border-violet-500/60 text-white shadow-[0_0_15px_rgba(139,92,246,0.3)]'
              : 'bg-white/[0.03] border-white/10 text-zinc-400 hover:text-white hover:bg-white/[0.08] hover:border-white/20'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8" id="projects-grid">
    {projects.map((project) => (
      <a
        href={project.url}
        data-cat={project.category}
        class="project-card group flex flex-col justify-between bg-[#0e121b]/80 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-md"
      >
        <!-- Card Thumbnail -->
        <div class="relative w-full aspect-[16/10] overflow-hidden bg-black/40">
          <img
            src={project.thumbnail}
            alt={project.name}
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0e121b] via-transparent to-black/20"></div>
          
          <!-- Category & Year Badges -->
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-black/60 backdrop-blur-md text-zinc-200 border border-white/10">
              {project.category}
            </span>
            <span class="px-2.5 py-1 text-xs font-mono text-zinc-400 rounded-full bg-black/40 backdrop-blur-md border border-white/5">
              {project.year}
            </span>
          </div>

          <!-- Status indicator -->
          <div class="absolute top-4 right-4">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium backdrop-blur-md border ${
              project.status === 'Hoàn thành'
                ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                : 'bg-amber-500/10 text-amber-400 border-amber-500/30'
            }`}>
              <span class={`w-1.5 h-1.5 rounded-full ${project.status === 'Hoàn thành' ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
              {project.status}
            </span>
          </div>
        </div>

        <!-- Card Content -->
        <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between gap-6">
          <div>
            <!-- Project Title & Index -->
            <div class="flex items-center justify-between gap-4 mb-3">
              <h2 class="text-2xl font-bold text-white group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-violet-200 group-hover:bg-clip-text transition-colors">
                {project.name}
              </h2>
              <span class="font-mono text-sm font-semibold text-zinc-500 group-hover:text-violet-400 transition-colors">
                {project.index}
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-zinc-400 leading-relaxed line-clamp-3">
              {project.description}
            </p>
          </div>

          <div>
            <!-- Card Bottom Action Link -->
            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300 group-hover:text-violet-300 transition-colors">
                Khám phá dự án
              </span>
              <div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-violet-600 group-hover:border-violet-500 transition-all duration-300">
                <svg
                  class="w-4 h-4 text-zinc-300 group-hover:text-white group-hover:translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </a>
    ))}
  </section>
</main>

<script src="../scripts/flow-field.ts"></script>

<script>
  function initProjectFilters() {
    const buttons = document.querySelectorAll('#category-filters button');
    const cards = document.querySelectorAll('#projects-grid .project-card') as NodeListOf<HTMLElement>;

    if (!buttons.length || !cards.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-category');

        // Update button styles
        buttons.forEach((b) => {
          b.classList.remove(
            'bg-violet-600/30',
            'border-violet-500/60',
            'text-white',
            'shadow-[0_0_15px_rgba(139,92,246,0.3)]'
          );
          b.classList.add('bg-white/[0.03]', 'border-white/10', 'text-zinc-400');
        });

        btn.classList.remove('bg-white/[0.03]', 'border-white/10', 'text-zinc-400');
        btn.classList.add(
          'bg-violet-600/30',
          'border-violet-500/60',
          'text-white',
          'shadow-[0_0_15px_rgba(139,92,246,0.3)]'
        );

        // Filter cards
        cards.forEach((card) => {
          const cat = card.getAttribute('data-cat');
          if (selected === 'Tất cả' || cat === selected) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Khởi chạy khi load và khi chuyển trang qua ClientRouter
  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);
</script>
</Layout>
