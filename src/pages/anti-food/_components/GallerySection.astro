const categories = [
  { id: "all", name: "All" },
  { id: "food", name: "Food" },
  { id: "interior", name: "Interior" },
  { id: "events", name: "Events" },
];

const galleryItems = [
  {
    id: 1,
    title: "Gourmet Pasta",
    category: "food",
    image: "https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 2,
    title: "Warm Ambience",
    category: "interior",
    image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 3,
    title: "Artisan Pizza",
    category: "food",
    image: "https://images.unsplash.com/photo-1604382355076-af4b0eb60143?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 4,
    title: "Signature Cocktail",
    category: "events",
    image: "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 5,
    title: "Chocolate Fondant",
    category: "food",
    image: "https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 6,
    title: "Cozy Dining Room",
    category: "interior",
    image: "https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 7,
    title: "Prime Beef Steak",
    category: "food",
    image: "https://images.unsplash.com/photo-1544025162-d76694265947?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 8,
    title: "Cocktail Evening",
    category: "events",
    image: "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=700&auto=format&fit=crop&q=80",
  },
  {
    id: 9,
    title: "Bar Atmosphere",
    category: "interior",
    image: "https://images.unsplash.com/photo-1578474846511-04ba529f0b88?w=700&auto=format&fit=crop&q=80",
  },
