---

<section id="menu" class="py-16 md:py-24 relative overflow-hidden scroll-mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Title -->
    <SectionTitle
      tag="Restaurant Menu"
      title="Our Menu"
      desc="Taste the authenticity of Italian cuisine, prepared with love"
      align="center"
    />

    <!-- Category Tabs -->
    <div data-reveal style="--delay: 100ms" class="flex items-center justify-center flex-wrap gap-2 sm:gap-3 mt-8 sm:mt-10">
      {
        categories.map((cat, index) => (
          <button
            type="button"
            data-category-tab={cat.id}
            class:list={[
              "menu-tab px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-300 cursor-pointer select-none",
              index === 0
                ? "bg-primary-4 text-[#1b3229] shadow-md active-tab"
                : "bg-white/80 hover:bg-white text-gray-600 hover:text-gray-900 border border-gray-200/80 shadow-xs",
            ]}
          >
            {cat.name}
          </button>
        ))
      }
    </div>

    <!-- Menu Items Wrapper with fixed minimum height to prevent layout shifting -->
    <div data-reveal style="--delay: 200ms" class="mt-12 sm:mt-14 min-h-[460px] md:min-h-[500px]">
      <div
        id="menu-items-grid"
        class="grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-14 gap-y-7 sm:gap-y-8 content-start"
      >
        {
          menuItems.map((item) => (
            <div
              data-menu-item
              data-item-category={item.category}
              class="menu-item flex items-center gap-4 sm:gap-5 group p-2 rounded-2xl hover:bg-white/60 transition-all duration-300"
            >
              <!-- Circular Dish Image -->
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden shrink-0 shadow-md border-2 border-white bg-amber-50">
                <img
                  src={item.image}
                  alt={item.name}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <!-- Dish Info -->
              <div class="flex-1 min-w-0">
                <h3 class="font-['Cormorant_Garamond',serif] font-bold text-lg sm:text-xl text-gray-900 group-hover:text-amber-700 transition-colors truncate">
                  {item.name}
                </h3>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5 font-['Mulish',sans-serif] line-clamp-1">
                  {item.description}
                </p>
                <p class="font-bold text-base sm:text-lg text-gray-900 mt-1 font-['Mulish',sans-serif]">
                  {item.price}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Dynamic Pagination Bar -->
    <div
      data-reveal
      style="--delay: 250ms"
      id="menu-pagination"
      class="flex items-center justify-center gap-2 sm:gap-2.5 mt-10 sm:mt-12 select-none"
    >
      <!-- Populated dynamically via JavaScript -->
    </div>
  </div>
</section>

<script>
  function setupMenuTabsAndPagination() {
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-category-tab]");
    const allItems = Array.from(document.querySelectorAll<HTMLElement>("[data-menu-item]"));
    const paginationEl = document.getElementById("menu-pagination");

    const ITEMS_PER_PAGE = 8;
    let currentCategory = "all";
    let currentPage = 1;

    function render() {
      // 1. Filter items by category
      const filteredItems = allItems.filter((item) => {
        const itemCategory = item.getAttribute("data-item-category");
        return currentCategory === "all" || itemCategory === currentCategory;
      });

      const totalPages = Math.ceil(filteredItems.length / ITEMS_PER_PAGE);
      if (currentPage > totalPages && totalPages > 0) {
        currentPage = totalPages;
      }
      if (currentPage < 1) {
        currentPage = 1;
      }

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;

      // 2. Hide all items first
      allItems.forEach((item) => {
        item.style.display = "none";
      });

      // 3. Display items for current page with fade/scale effect
      filteredItems.forEach((item, index) => {
        if (index >= startIndex && index < endIndex) {
          item.style.display = "flex";
          item.style.opacity = "0";
          item.style.transform = "scale(0.96)";
          requestAnimationFrame(() => {
            item.style.transition = "opacity 0.25s ease, transform 0.25s ease";
            item.style.opacity = "1";
            item.style.transform = "scale(1)";
          });
        }
      });

      // 4. Render Pagination Controls
      if (!paginationEl) return;

      if (totalPages <= 1) {
        paginationEl.innerHTML = "";
        paginationEl.style.display = "none";
        return;
      }

      paginationEl.style.display = "flex";
      let html = "";

      // Prev Button
      const isPrevDisabled = currentPage === 1;
      html += `
        <button
          type="button"
          data-page="prev"
          ${isPrevDisabled ? "disabled" : ""}
          class="w-10 h-10 rounded-full flex items-center justify-center bg-white border border-gray-200/80 text-gray-700 hover:bg-amber-50 hover:text-gray-900 transition-all duration-200 shadow-xs cursor-pointer disabled:opacity-40 disabled:pointer-events-none"
          aria-label="Previous page"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
      `;

      // Page Number Buttons
      for (let p = 1; p <= totalPages; p++) {
        const isActive = p === currentPage;
        html += `
          <button
            type="button"
            data-page="${p}"
            class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold transition-all duration-200 shadow-xs cursor-pointer ${
              isActive
                ? "bg-primary-4 text-[#1b3229] shadow-md scale-105"
                : "bg-white hover:bg-amber-50 text-gray-700 border border-gray-200/80"
            }"
          >
            ${p}
          </button>
        `;
      }

      // Next Button
      const isNextDisabled = currentPage === totalPages;
      html += `
        <button
          type="button"
          data-page="next"
          ${isNextDisabled ? "disabled" : ""}
          class="w-10 h-10 rounded-full flex items-center justify-center bg-white border border-gray-200/80 text-gray-700 hover:bg-amber-50 hover:text-gray-900 transition-all duration-200 shadow-xs cursor-pointer disabled:opacity-40 disabled:pointer-events-none"
          aria-label="Next page"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      `;

      paginationEl.innerHTML = html;

      // Attach pagination button click listeners
      paginationEl.querySelectorAll<HTMLButtonElement>("[data-page]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const action = btn.getAttribute("data-page");
          if (action === "prev" && currentPage > 1) {
            currentPage--;
          } else if (action === "next" && currentPage < totalPages) {
            currentPage++;
          } else if (action && !isNaN(Number(action))) {
            currentPage = Number(action);
          }
          render();

          // Smooth scroll to top of menu section if user is scrolled down
          const menuSection = document.getElementById("menu");
          if (menuSection) {
            const rect = menuSection.getBoundingClientRect();
            if (rect.top < 0) {
              menuSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }
        });
      });
    }

    // Tab click listeners
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const cat = tab.getAttribute("data-category-tab") || "all";
        currentCategory = cat;
        currentPage = 1; // Reset to page 1 on category change

        // Update active tab styles
        tabs.forEach((t) => {
          t.classList.remove("bg-primary-4", "text-[#1b3229]", "shadow-md", "active-tab");
          t.classList.add("bg-white/80", "text-gray-600", "border", "border-gray-200/80", "shadow-xs");
        });

        tab.classList.add("bg-primary-4", "text-[#1b3229]", "shadow-md", "active-tab");
        tab.classList.remove("bg-white/80", "text-gray-600", "border", "border-gray-200/80", "shadow-xs");

        render();
      });
    });

    // Initial render
    render();
  }

  // Setup on page load and astro page swap
  setupMenuTabsAndPagination();
  document.addEventListener("astro:page-load", setupMenuTabsAndPagination);
</script>