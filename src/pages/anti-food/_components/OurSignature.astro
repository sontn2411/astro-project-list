---
import SectionTitle from "./SectionTitle.astro";
import foodleft from "../_assets/food-signature-left.png";
import foodleftTop from "../_assets/food-signature-left-top.png";
import foodrightBottom from "../_assets/food-signature-right-bottom.png";
import { Icon } from "astro-icon/components";

const signatureDishes = [
  {
    id: 1,
    name: "Grilled Chicken Bowl",
    price: "$12.00",
    rating: "4.8",
    image: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80",
    link: "#grilled-chicken",
  },
  {
    id: 2,
    name: "Creamy Alfredo Pasta",
    price: "$11.00",
    rating: "4.7",
    image: "https://images.unsplash.com/photo-1645112411341-6c4fd023714a?w=600&auto=format&fit=crop&q=80",
    link: "#alfredo-pasta",
  },
  {
    id: 3,
    name: "Margherita Pizza",
    price: "$10.00",
    rating: "4.9",
    image: "https://images.unsplash.com/photo-1604382355076-af4b0eb60143?w=600&auto=format&fit=crop&q=80",
    link: "#margherita-pizza",
  },
  {
    id: 4,
    name: "Chocolate Lava Cake",
    price: "$6.00",
    rating: "4.8",
    image: "https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=600&auto=format&fit=crop&q=80",
    link: "#chocolate-lava",
  },
];
---

<section class="bg-dark-green py-16 md:py-24 relative overflow-hidden">
  <!-- Ảnh đĩa món ăn góc dưới bên trái -->
  <div class="absolute bottom-0 left-0 z-0 pointer-events-none select-none">
    <img
      src={foodleft.src}
      alt="food-left"
      class="w-32 sm:w-44 md:w-56 lg:w-64 max-h-[50%] object-contain object-bottom object-left drop-shadow-2xl opacity-75"
    />
  </div>
   <div class="absolute top-10 left-10 z-0 pointer-events-none select-none ">
    <img
      src={foodleftTop.src}
      alt="food-left"
      class="w-32 sm:w-44 md:w-56 lg:w-64 max-h-[50%] object-contain object-bottom object-left drop-shadow-2xl "
    />
  </div>
    <div class="absolute bottom-0 right-0 z-0 pointer-events-none select-none ">
    <img
      src={foodrightBottom.src}
      alt="food-left"
      class="w-32 sm:w-44 md:w-56 lg:w-64 max-h-[50%] object-contain object-bottom object-left drop-shadow-2xl "
    />
  </div>


  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <!-- Header Title -->
    <SectionTitle
      tag="CHEF'S SELECTION"
      title="Our Signature Dishes"
      desc="Explore our diverse menu crafted with the freshest ingredients and a passion for great taste."
      theme="dark"
    />

    <!-- Danh sách sản phẩm (4 items) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 md:mt-16">
      {
        signatureDishes.map((item) => (
          <div class="bg-[#112a1c] border border-white/10 rounded-2xl p-4 flex flex-col justify-between  transition-all duration-300 hover:-translate-y-1.5 shadow-xl group">
            <div>
              <!-- Hình ảnh món ăn -->
              <div class="aspect-4/3 sm:aspect-square rounded-xl overflow-hidden mb-4 bg-black/20">
                <img
                  src={item.image}
                  alt={item.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>

              <!-- Tên món ăn -->
              <h3 class="font-bold text-white text-base sm:text-lg tracking-tight group-hover:text-primary-4 transition-colors">
                {item.name}
              </h3>

              <!-- Đường line trang trí màu vàng -->
              <div class="w-7 h-[2px] bg-primary-4/80 rounded-full my-2.5" />
            </div>

            <!-- Giá, Đánh giá và nút Order -->
            <div class="flex items-end justify-between pt-1">
              <div>
                <span class="text-white font-bold text-lg sm:text-xl tracking-tight block">
                  {item.price}
                </span>
                <div class="flex items-center gap-1.5 text-xs text-amber-400 mt-0.5">
                  <Icon
                    name="lucide:star"
                    class="w-3.5 h-3.5 fill-amber-400 text-amber-400"
                  />
                  <span class="text-white/80 font-medium">{item.rating}</span>
                </div>
              </div>

              <a
                href={item.link}
                class="w-10 h-10 rounded-full bg-[#4fa336] text-[#0b2114] flex items-center justify-center hover:bg-primary-4 transition-all duration-300 shadow-md group/btn"
                aria-label={`Order ${item.name}`}
              >
                <Icon
                  name="lucide:arrow-right"
                  class="w-4 h-4 transition-transform group-hover/btn:translate-x-0.5"
                />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Nút View Full Menu -->
    <div class="text-center mt-12 md:mt-16">
      <a
        href="#menu"
        class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-full border border-white text-white font-semibold text-sm hover:bg-white hover:text-[#0b2114] transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <span>View Full Menu</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>