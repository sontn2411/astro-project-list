---
import { Icon } from "astro-icon/components";
// import leaf1 from "../_assets/leaf-1.png";
---

<section class="bg-dark-green py-16 md:py-20 lg:py-24 relative overflow-hidden">

  <!-- <div class="absolute -left-6 sm:-left-2 md:left-0 top-1/2 -translate-y-1/2 pointer-events-none select-none z-0">
    <img
      src={leaf1.src}
      alt="Botanical Leaf"
      class="w-28 sm:w-36 md:w-44 lg:w-52 object-contain opacity-75"
    />
  </div> -->

  <!-- Gourmet pasta dish peeking from the right edge -->
  <div class="absolute right-0 top-0 bottom-0 w-full sm:w-3/5 lg:w-1/2 pointer-events-none select-none z-0 overflow-hidden">
    <div class="relative w-full h-full">
      <img
        src="https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=1000&auto=format&fit=crop&q=80"
        alt="Gourmet Dish"
        class="w-full h-full object-cover object-left opacity-60 mix-blend-luminosity brightness-90 contrast-110 scale-105"
        loading="lazy"
      />
      <!-- Gradient overlays to seamlessly blend with dark-green background -->
      <div class="absolute inset-0 bg-gradient-to-r from-dark-green via-dark-green/75 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-dark-green via-transparent to-dark-green"></div>
    </div>
  </div>

  <!-- Main Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Typography & Content -->
      <div data-reveal="left" class="lg:col-span-6 xl:col-span-5 relative z-10">
        <span class="text-primary-4 font-bold tracking-[0.2em] text-xs sm:text-sm uppercase inline-block">
          #SPECIAL OFFER
        </span>

        <h2 class="font-['Cormorant_Garamond',serif] font-bold text-3xl sm:text-4xl lg:text-5xl text-white leading-[1.15] mt-2 sm:mt-3">
          Get 20% Off <br />
          Your First Order
        </h2>

        <p class="text-white/70 text-sm sm:text-base leading-relaxed mt-3 sm:mt-4 max-w-md font-['Mulish',sans-serif]">
          Sign up and enjoy a special 20% discount on your first meal at Anti. Good food is always a good idea!
        </p>
      </div>

      <!-- Right Column: Gift Line, Doodle & Subscribe Input -->
      <div data-reveal="right" style="--delay: 150ms" class="lg:col-span-6 xl:col-span-7 flex flex-col items-start lg:items-end justify-center w-full relative z-10">
        <div class="w-full max-w-xl">
          <!-- Decorative divider with centered gift badge -->
          <div class="flex items-center gap-3 sm:gap-4 w-full mb-5">
            <div class="h-px bg-gradient-to-r from-transparent via-white/20 to-white/20 flex-1"></div>
            <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#112a1c] border border-primary-4/50 shadow-lg shadow-black/40 shrink-0">
              <Icon name="lucide:gift" class="w-4 h-4 text-primary-4" />
              <span class="text-xs font-semibold text-primary-4 tracking-wider uppercase">
                Instant Voucher
              </span>
            </div>
            <div class="h-px bg-gradient-to-r from-white/20 via-white/20 to-transparent flex-1"></div>
          </div>

          <!-- Email Subscription Form -->
          <form class="bg-white rounded-full p-1.5 sm:p-2 pl-5 sm:pl-7 flex items-center shadow-2xl w-full transition-all duration-300 focus-within:ring-2 focus-within:ring-primary-4/50 hover:shadow-primary-4/10">
            <input
              type="email"
              placeholder="Your Email Address..."
              required
              class="flex-1 bg-transparent text-gray-800 placeholder:text-gray-400 text-sm sm:text-base outline-none font-['Mulish',sans-serif] pr-3"
            />
            <button
              type="submit"
              class="px-6 sm:px-9 py-3 sm:py-3.5 rounded-full bg-primary-4 text-[#1b3229] font-bold text-xs sm:text-sm hover:bg-primary-4/90 hover:shadow-lg transition-all duration-300 active:scale-95 shrink-0 font-['Mulish',sans-serif]"
            >
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>